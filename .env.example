AEGIS_HTTP_PORT=8080
AEGIS_HTTPS_PORT=443
AEGIS_LOCAL_HTTPS_PORT=8443
# Required at deploy time; set this to an immutable image/build identity.
AEGIS_RELEASE_ID=
# Set a publicly routable hostname before enabling the production tls profile.
AEGIS_TLS_HOST=files.your-domain.invalid
AEGIS_PUBLIC_URL=http://localhost:8080
AEGIS_ALLOWED_HOSTS=localhost,127.0.0.1,web
AEGIS_DB_HOST=postgres
AEGIS_DB_PORT=5432
AEGIS_DB_NAME=aegis
AEGIS_UID=10001
AEGIS_GID=10001
AEGIS_SCAN_INTERVAL_SECONDS=3600
AEGIS_SCAN_IDLE_TIMEOUT_SECONDS=120
AEGIS_SCAN_BATCH_RECORDS=500
AEGIS_SCAN_READERS=2
