class InstallError(RuntimeError):
    """The installer refuses, or cannot finish safely; what it did so far is recorded."""


class LockBusy(InstallError):
    """Another aegis-podman command holds the lock."""


def run_command(arguments: Sequence[str], *, timeout: float) -> subprocess.CompletedProcess[str]:
    """Run one program as an argument vector, never through a shell, with nothing on stdin."""
    return subprocess.run(
        list(arguments), stdin=subprocess.DEVNULL, capture_output=True, text=True,
        timeout=timeout, check=False,
    )


def port_in_use(port: int) -> bool:
    """Whether something already listens on ``port`` on any IPv4 or IPv6 address.

    It binds each family's wildcard address, as the systemd socket will, and closes at once.
    """
    for family, address in ((socket.AF_INET, "0.0.0.0"), (socket.AF_INET6, "::")):
        try:
            probe = socket.socket(family, socket.SOCK_STREAM)
        except OSError:
            continue  # the host does not offer this address family
        with probe:
            probe.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
            if family == socket.AF_INET6:
                probe.setsockopt(socket.IPPROTO_IPV6, socket.IPV6_V6ONLY, 1)
            try:
                probe.bind((address, port))
            except OSError as error:
                if error.errno == errno.EADDRINUSE:
                    return True
                if error.errno in (errno.EADDRNOTAVAIL, errno.EAFNOSUPPORT):
                    continue
                raise InstallError(f"cannot test port {port}: {error.strerror}") from None
    return False


@dataclass
class Host:
    """Everything outside the installer's own code: programs, clock, sockets and paths.

    Every program runs through ``run``, and every file the installer writes is under
    ``home`` or the XDG directories ``environ`` names, so tests replace the host with fakes
    and a temporary directory.
    """

    home: Path
    run: Runner = run_command
    out: TextIO = field(default_factory=lambda: sys.stdout)
    err: TextIO = field(default_factory=lambda: sys.stderr)
    uid: int = field(default_factory=os.getuid)
    gid: int = field(default_factory=os.getgid)
    environ: Mapping[str, str] = field(default_factory=lambda: dict(os.environ))
    monotonic: Callable[[], float] = time.monotonic
    sleep: Callable[[float], None] = time.sleep
    port_in_use: Callable[[int], bool] = port_in_use
    quadlet: Path = Path("/usr/libexec/podman/quadlet")
    selinux_enforce: Path = Path("/sys/fs/selinux/enforce")


def _absolute(name: str, value: str) -> Path:
    if not os.path.isabs(value):
        raise InstallError(f"{name} must be an absolute path, not {value!r}")
    return Path(os.path.normpath(value))


@dataclass(frozen=True)
class Paths:
    """Where the installer keeps its files.

    ``config`` is the XDG configuration home, under which systemd and Quadlet read user
    units. ``data`` holds the record, secrets, release trees and lock. It is always
    ``~/.local/share/aegis``, whatever a shell sets ``XDG_DATA_HOME`` to, so every session
    finds the same record; ``--state-home`` is the only alternative, and the configuration
    file then moves there too, so a test install never shares a file with the operator's.
    """

    config: Path
    data: Path
    config_directory: Path

    @classmethod
    def resolve(
        cls, home: Path, environ: Mapping[str, str], state_home: str | None = None,
    ) -> Paths:
        config_value = environ.get("XDG_CONFIG_HOME", "")
        config = _absolute("XDG_CONFIG_HOME", config_value) if config_value else home / ".config"
        if state_home is not None:
            data = _absolute("--state-home", state_home)
            return cls(config=config, data=data, config_directory=data)
        data = home / ".local" / "share" / "aegis"
        return cls(config=config, data=data, config_directory=config / "aegis")

    @property
    def env_file(self) -> Path:
        return self.config_directory / "aegis.env"

    @property
    def secrets(self) -> Path:
        return self.data / "secrets"

    @property
    def releases(self) -> Path:
        return self.data / "releases"

    @property
    def state(self) -> Path:
        return self.data / "state.json"

    @property
    def lock(self) -> Path:
        return self.data / "lock"

    def release_tree(self, release: str) -> Path:
        return self.releases / release / "podman"

    def unit_directories(self) -> tuple[Path, ...]:
        return tuple(self.config / directory for directory in sorted(INSTALL_DIRECTORIES))

    def private_directories(self) -> tuple[Path, ...]:
        """The installer's own directories, each after its parent."""
        ordered = (self.config_directory, self.data, self.secrets, self.releases)
        return tuple(dict.fromkeys(ordered))

    def removable_roots(self) -> tuple[Path, ...]:
        """Where a recorded file may be: nothing outside these is ever removed."""
        return (*self.unit_directories(), self.config_directory, self.secrets, self.releases)


