class InstallError(RuntimeError):
    """The installer refuses, or cannot finish safely; what it did so far is recorded."""


class LockBusy(InstallError):
    """Another aegis-podman command holds the lock."""


def run_command(
    arguments: Sequence[str], *, timeout: float, env: Mapping[str, str] | None = None,
) -> subprocess.CompletedProcess[str]:
    """Run one program as an argument vector, never through a shell, with nothing on stdin.

    ``env`` replaces the environment; without it the program inherits the installer's.
    """
    return subprocess.run(
        list(arguments), stdin=subprocess.DEVNULL, capture_output=True, text=True,
        timeout=timeout, check=False, env=None if env is None else dict(env),
    )


def read_selinux_label(path: str, name: str) -> bytes:
    """An extended attribute of ``path`` itself, never of what a link points to."""
    return os.getxattr(path, name, follow_symlinks=False)


def login_name(uid: int) -> str:
    return pwd.getpwuid(uid).pw_name


def port_in_use(port: int) -> bool:
    """Whether something already listens on ``port`` on any IPv4 or IPv6 address.

    It binds each family's wildcard address, as the systemd socket will, and closes at once.
    """
    for family, address in ((socket.AF_INET, "0.0.0.0"), (socket.AF_INET6, "::")):
        try:
            probe = socket.socket(family, socket.SOCK_STREAM)
        except OSError:
            continue  # the host does not offer this address family
        with probe:
            probe.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
            if family == socket.AF_INET6:
                probe.setsockopt(socket.IPPROTO_IPV6, socket.IPV6_V6ONLY, 1)
            try:
                probe.bind((address, port))
            except OSError as error:
                if error.errno == errno.EADDRINUSE:
                    return True
                if error.errno in (errno.EADDRNOTAVAIL, errno.EAFNOSUPPORT):
                    continue
                raise InstallError(f"cannot test port {port}: {error.strerror}") from None
    return False


@dataclass
class Host:
    """Everything outside the installer's own code: programs, clock, sockets and paths.

    Every program runs through ``run``, and every file the installer writes is under
    ``home`` or the XDG directories ``environ`` names, so tests replace the host with fakes
    and a temporary directory.
    """

    home: Path
    run: Runner = run_command
    out: TextIO = field(default_factory=lambda: sys.stdout)
    err: TextIO = field(default_factory=lambda: sys.stderr)
    uid: int = field(default_factory=os.getuid)
    gid: int = field(default_factory=os.getgid)
    environ: Mapping[str, str] = field(default_factory=lambda: dict(os.environ))
    monotonic: Callable[[], float] = time.monotonic
    sleep: Callable[[float], None] = time.sleep
    port_in_use: Callable[[int], bool] = port_in_use
    quadlet: Path = Path("/usr/libexec/podman/quadlet")
    selinux_enforce: Path = Path("/sys/fs/selinux/enforce")
    # The host's Python, which runs the release's aegisctl: the one running this installer.
    python: str = field(default_factory=lambda: sys.executable or "python3")
    getxattr: Callable[[str, str], bytes] = read_selinux_label
    login_name: Callable[[int], str] = login_name
    # The installer's own mount table: the file system that would hold the derivatives.
    mountinfo: Path = Path("/proc/self/mountinfo")
    # This boot's random ID, recorded with a pending upgrade: a reboot changes it.
    boot_id: Path = Path("/proc/sys/kernel/random/boot_id")


def _absolute(name: str, value: str) -> Path:
    if not os.path.isabs(value):
        raise InstallError(f"{name} must be an absolute path, not {value!r}")
    return Path(os.path.normpath(value))


@dataclass(frozen=True)
class Paths:
    """Where the installer keeps its files.

    ``config`` is the XDG configuration home, under which systemd and Quadlet read user
    units. ``data`` holds the record, secrets, release trees and lock. It is always
    ``~/.local/share/aegis``, whatever a shell sets ``XDG_DATA_HOME`` to, so every session
    finds the same record; ``--state-home`` is the only alternative, and the configuration
    file then moves there too, so a test install never shares a file with the operator's.
    """

    config: Path
    data: Path
    config_directory: Path

    @classmethod
    def resolve(
        cls, home: Path, environ: Mapping[str, str], state_home: str | None = None,
    ) -> Paths:
        # A relative XDG value is invalid and ignored, as the XDG base directory spec says
        # and as the systemd user manager itself does.
        config_value = environ.get("XDG_CONFIG_HOME", "")
        config = (Path(os.path.normpath(config_value)) if os.path.isabs(config_value)
                  else home / ".config")
        if state_home is not None:
            data = _absolute("--state-home", state_home)
            return cls(config=config, data=data, config_directory=data)
        data = home / ".local" / "share" / "aegis"
        return cls(config=config, data=data, config_directory=config / "aegis")

    @property
    def env_file(self) -> Path:
        return self.config_directory / "aegis.env"

    @property
    def secrets(self) -> Path:
        return self.data / "secrets"

    @property
    def releases(self) -> Path:
        return self.data / "releases"

    @property
    def state(self) -> Path:
        return self.data / "state.json"

    @property
    def lock(self) -> Path:
        return self.data / "lock"

    @property
    def mounts(self) -> Path:
        """The root manifest and gateway attestation the drop-ins bind."""
        return self.data / "mounts"

    @property
    def selinux(self) -> Path:
        return self.data / "selinux"

    @property
    def selinux_module(self) -> Path:
        return self.selinux / "aegis_reader.cil"

    @property
    def host_setup(self) -> Path:
        return self.data / "host-setup.sh"

    @property
    def mounts_config(self) -> Path:
        """aegisctl's mount configuration, written from the record's roots."""
        return self.config_directory / "mounts.toml"

    def release_tree(self, release: str) -> Path:
        return self.releases / release / "podman"

    def library(self, release: str) -> Path:
        return self.releases / release / "lib"

    def manifest(self, generation: str) -> Path:
        return self.mounts / f"manifest.{generation}.json"

    def attestation(self, generation: str) -> Path:
        return self.mounts / f"gateway.{generation}.attestation"

    def drop_in(self, prefix: str, role: str) -> Path:
        return (self.config / UNIT_DIRECTORIES[".container"] / f"{prefix}{role}.container.d"
                / DROP_IN)

    def unit_directories(self) -> tuple[Path, ...]:
        return tuple(self.config / directory for directory in sorted(INSTALL_DIRECTORIES))

    def private_directories(self) -> tuple[Path, ...]:
        """The installer's own directories, each after its parent."""
        ordered = (
            self.config_directory, self.data, self.secrets, self.releases, self.mounts,
            self.selinux,
        )
        return tuple(dict.fromkeys(ordered))

    def removable_roots(self) -> tuple[Path, ...]:
        """Where a recorded file may be: nothing outside these is ever removed."""
        return (*self.unit_directories(), self.config_directory, self.data)


# Field types of the record; a record that does not match is refused, not half-read.
_STATE_TYPES: dict[str, type | tuple[type, ...]] = {
    "phase": str, "release": str, "registry": str, "prefix": str, "names": list,
    "https_port": int, "host_gid": int, "backend_subnet": str, "reader_type": str,
    "install_token": str, "images": dict, "created": (str, type(None)),
    "pending": (dict, type(None)), "desired": str, "install_sections": bool,
    "firewall_zones": list, "installed": bool, "history": list, "files": dict,
    "secrets": dict, "releases": dict, "units": dict, "volumes": list, "networks": list,
    "extractions": list, "roots": dict, "selinux_covered": list, "selinux_pending": list,
    "mounts": dict, "local_images": bool, "derivatives": (dict, type(None)),
    "label_level": (str, type(None)), "level_migration": (dict, type(None)),
    "scan_interval_hours": (int, type(None)), "scan_interval_rendered": bool, "version": int,
}
_INVENTORY_TYPES: dict[str, type] = {
    "files": list, "socket": str, "services": list, "oneshots": list, "generated": list,
    "containers": dict, "health_checked": list, "images": dict,
}


@dataclass
class State:
    """The record (``state.json``): what the installer configured, wrote and owns.

    ``files`` maps every file it wrote (units, drop-ins, configuration, release trees and
    libraries, the SELinux module and the host-setup script) to its sha256. ``secrets`` maps
    each secret file to its device, inode and change time: once handed to the container user,
    the operator can no longer read it. ``volumes`` and ``networks`` are the names its units
    define; each object Quadlet creates carries ``install_token`` as a label, and only an
    object that does is ever removed. ``pending`` is an upgrade whose units may already be
    written but which is not yet committed. ``desired`` is the run state the operator last
    asked for. ``history`` lists, in order, every release that became current.

    ``roots`` maps each slot to its source, expected identity and SELinux type: exactly the
    roots that the installed and loaded drop-ins mount. ``selinux_covered`` are the types a
    probe proved the loaded module grants; ``selinux_pending`` are in the module file but not
    yet proven loaded. ``mounts`` records each generation of the manifest (by device, inode
    and change time, once it belongs to the container user) and gateway attestation (by
    sha256). ``current`` is the generation the installed drop-ins bind; ``installing`` is set
    from the first drop-in written until systemd has loaded them all, so an interrupted
    switch is flagged, rendered again by the next command, and never pruned meanwhile.

    ``local_images`` marks a deployment-test stack (spec D12) whose ``images`` are local image
    IDs rather than pulled digests; like the ``container_t`` reader type, it never applies to
    the production prefix.

    ``derivatives`` is the operator directory the derivatives volume binds (spec M8), or None
    for a plain named volume: its path, its device and inode when it was adopted, and whether
    its preparation for the containers finished. It never changes once recorded.

    ``label_level`` is the SELinux MCS level every container of this install shares, drawn at
    random when the install is initialized (or, for a record from before it existed, when the
    units of a release that uses it are next written) and kept from then on.
    ``level_migration`` maps each volume recorded before that late draw to whether its content
    is relabelled to the level yet (a one-time migration); None when there was nothing to do.

    ``scan_interval_hours`` is the indexer's wait between scans of a root, set at init and
    kept until an upgrade changes it; None until a release that takes the setting (render
    API 3) is current, which then records the default. ``scan_interval_rendered`` says whether
    the current release's units carry it: a release from before the setting scans hourly,
    and a kept value applies again at the next upgrade to a release that takes it.
    """

    phase: str
    release: str
    registry: str
    prefix: str
    names: list[str]
    https_port: int
    host_gid: int
    backend_subnet: str
    reader_type: str
    install_token: str
    images: dict[str, str] = field(default_factory=dict)
    created: str | None = None
    pending: dict[str, Any] | None = None
    desired: str = "stopped"
    install_sections: bool = True
    firewall_zones: list[str] = field(default_factory=list)
    installed: bool = False
    history: list[dict[str, Any]] = field(default_factory=list)
    files: dict[str, dict[str, Any]] = field(default_factory=dict)
    secrets: dict[str, dict[str, Any]] = field(default_factory=dict)
    releases: dict[str, dict[str, str]] = field(default_factory=dict)
    units: dict[str, Any] = field(default_factory=dict)
    volumes: list[str] = field(default_factory=list)
    networks: list[str] = field(default_factory=list)
    extractions: list[str] = field(default_factory=list)
    roots: dict[str, dict[str, str]] = field(default_factory=dict)
    selinux_covered: list[str] = field(default_factory=list)
    selinux_pending: list[str] = field(default_factory=list)
    mounts: dict[str, Any] = field(
        default_factory=lambda: {"current": None, "installing": None, "generations": {}},
    )
    local_images: bool = False
    derivatives: dict[str, Any] | None = None
    label_level: str | None = None
    level_migration: dict[str, bool] | None = None
    scan_interval_hours: int | None = None
    scan_interval_rendered: bool = False
    version: int = STATE_VERSION

    @classmethod
    def from_json(cls, data: object) -> State:
        if isinstance(data, dict):
            # A record written before roots, local images, a derivatives directory or the scan
            # interval existed.
            defaults: dict[str, Any] = {
                "roots": {}, "selinux_covered": [], "selinux_pending": [],
                "mounts": {"current": None, "generations": {}}, "local_images": False,
                "derivatives": None, "label_level": None, "level_migration": None,
                "scan_interval_hours": None, "scan_interval_rendered": False,
            }
            data = defaults | data
            if isinstance(data["mounts"], dict):
                data["mounts"] = {"installing": None} | data["mounts"]
            for key in ("selinux_covered", "selinux_pending"):
                values = data[key]
                blocked = [
                    value for value in values if isinstance(value, str)
                    and SELINUX_TYPE.fullmatch(value) and _type_problem(value) is not None
                ] if isinstance(values, list) else []
                if blocked:
                    # A later blocklist must not lock the operator out of the record.
                    print(f"aegis-podman: warning: the record names SELinux types that are "
                          f"never granted now ({', '.join(blocked)}); dropping them",
                          file=sys.stderr)
                    data[key] = [value for value in values if value not in blocked]
        problem = _record_problem(data)
        if problem is not None:
            raise InstallError(f"the aegis-podman record is not usable ({problem}); it was "
                               "not changed")
        assert isinstance(data, dict)
        return cls(**data)


def _record_problem(data: object) -> str | None:
    """What makes ``data`` an unusable record, or None."""
    if not isinstance(data, dict):
        return "not an object"
    if set(data) != set(_STATE_TYPES):
        return "unknown fields"
    for name, expected in _STATE_TYPES.items():
        value = data[name]
        if isinstance(value, bool) and expected is int:
            return f"{name} has the wrong type"
        if not isinstance(value, expected):
            return f"{name} has the wrong type"
    if data["version"] != STATE_VERSION or data["phase"] not in PHASES:
        return "unknown version or phase"
    if data["desired"] not in DESIRED:
        return "unknown run state"
    if INSTALL_TOKEN.fullmatch(data["install_token"]) is None:
        return "malformed install token"
    if not all(isinstance(record, dict) and isinstance(record.get("sha256"), str)
               and isinstance(record.get("kind"), str) for record in data["files"].values()):
        return "malformed file entries"
    if not all(isinstance(record, dict) for record in data["secrets"].values()):
        return "malformed secret entries"
    pending = data["pending"]
    if pending is not None and not (
        isinstance(pending.get("release"), str) and isinstance(pending.get("images"), dict)
        and isinstance(pending.get("restart_queued", False), bool)
        and isinstance(pending.get("local_images", False), bool)
        and (pending.get("boot_id") is None
             or (isinstance(pending["boot_id"], str)
                 and BOOT_ID.fullmatch(pending["boot_id"]) is not None))
    ):
        return "malformed pending upgrade"
    if pending is not None and (
        _derivatives_problem(pending.get("previous_derivatives"))
        or _scan_interval_problem(pending.get("scan_interval_hours"))
    ):
        return "malformed pending upgrade"
    if pending is not None and data["prefix"] == PRODUCTION_PREFIX and (
        pending.get("local_images", False) or TEST_RELEASE.fullmatch(pending["release"])
    ):
        return (f"a pending upgrade to local images or a test release is for the deployment "
                f"test, never the {PRODUCTION_PREFIX} prefix")
    if data["install_sections"] and data["prefix"] != PRODUCTION_PREFIX:
        return f"a stack with the prefix {data['prefix']} must never have [Install] sections"
    if data["reader_type"] not in READER_TYPES:
        return "unknown reader type"
    if data["prefix"] == PRODUCTION_PREFIX and (
        data["local_images"] or data["reader_type"] == TEST_READER_TYPE
    ):
        return (f"local images and {TEST_READER_TYPE} readers are for the deployment test, "
                f"never the {PRODUCTION_PREFIX} prefix")
    if TEST_RELEASE.fullmatch(data["release"]) and not data["local_images"]:
        return "a test release without local images"
    if data["installed"] and not all(
        isinstance(data["units"].get(key), expected) for key, expected in _INVENTORY_TYPES.items()
    ):
        return "installed without a unit inventory"
    if _derivatives_problem(data["derivatives"]):
        return "malformed derivatives directory"
    if _scan_interval_problem(data["scan_interval_hours"]) or (
        data["scan_interval_rendered"] and data["scan_interval_hours"] is None
    ):
        return "malformed scan interval"
    if data["label_level"] is not None:
        try:
            _label_level(data["label_level"])
        except RenderError:
            return "malformed SELinux level"
    migration = data["level_migration"]
    if migration is not None and (
        data["label_level"] is None
        or not all(isinstance(name, str) and isinstance(done, bool)
                   for name, done in migration.items())
    ):
        return "malformed SELinux level migration"
    return _roots_problem(data)


def _derivatives_problem(record: object) -> bool:
    """Whether a recorded derivatives directory is malformed (None is a plain volume)."""
    if record is None:
        return False
    if not isinstance(record, dict) or set(record) != {"path", "device", "inode", "prepared"}:
        return True
    try:
        _derivatives_dir(record["path"])
    except RenderError:
        return True
    return not (
        all(type(record[key]) is int and record[key] >= 0 for key in ("device", "inode"))
        and isinstance(record["prepared"], bool)
    )


def _scan_interval_problem(value: object) -> bool:
    """Whether a recorded scan interval is malformed (None is a record from before it)."""
    return value is not None and not (
        type(value) is int and 1 <= value <= MAX_SCAN_INTERVAL_HOURS
    )


def _scan_interval_hours(state: State) -> int:
    """The recorded scan interval, or the default for a record from before it."""
    if state.scan_interval_hours is None:
        return DEFAULT_SCAN_INTERVAL_HOURS
    return state.scan_interval_hours


def _takes_scan_interval(module: types.ModuleType) -> bool:
    """Whether a release's renderer takes the scan interval; units before it scan hourly."""
    return bool(module.RENDER_API >= 3)


def _note_scan_interval(state: State, module: types.ModuleType) -> None:
    """Record whether the current release's units, rendered by ``module``, carry the scan
    interval; once they do, a record from before the setting takes the default."""
    state.scan_interval_rendered = _takes_scan_interval(module)
    if state.scan_interval_rendered and state.scan_interval_hours is None:
        state.scan_interval_hours = DEFAULT_SCAN_INTERVAL_HOURS


def _refuse_scan_interval(release: str, step: str) -> None:
    raise InstallError(f"release {release} scans hourly and has no scan interval setting; "
                       f"{step} without --scan-interval-hours")


def _effective_scan_interval(state: State) -> int:
    """The hours the current release's units wait between scans of a root."""
    return _scan_interval_hours(state) if state.scan_interval_rendered else 1


def _roots_problem(data: Mapping[str, Any]) -> str | None:
    """What makes the record's roots, SELinux types or mount generations unusable."""
    for slot, root in data["roots"].items():
        if not (
            SLOT_ID.fullmatch(slot) and isinstance(root, dict)
            and set(root) == {"source", "identity", "selinux_type"}
            and all(isinstance(value, str) for value in root.values())
        ):
            return "malformed root entries"
    for value in (*data["selinux_covered"], *data["selinux_pending"]):
        if not isinstance(value, str) or _type_problem(value) is not None:
            return "malformed SELinux types"
    mounts = data["mounts"]
    generations = mounts.get("generations")
    if (
        set(mounts) != {"current", "installing", "generations"}
        or not isinstance(generations, dict)
        or not all(
            GENERATION.fullmatch(name) and isinstance(record, dict)
            and set(record) == {"manifest", "attestation"}
            and isinstance(record["manifest"], (dict, type(None)))
            and isinstance(record["attestation"], (str, type(None)))
            for name, record in generations.items()
        )
        or any(mounts[key] is not None and mounts[key] not in generations
               for key in ("current", "installing"))
    ):
        return "malformed mount generations"
    return None


@dataclass(frozen=True)
class RenderedUnit:
    name: str
    path: Path
    text: str


# -- running programs --------------------------------------------------------------------------


def _say(host: Host, text: str = "") -> None:
    print(text, file=host.out)


def _detail(text: str | None) -> str:
    lines = [line.strip() for line in (text or "").splitlines() if line.strip()]
    return f": {lines[-1][:300]}" if lines else ""


def _run(
    host: Host, arguments: Sequence[str], *, timeout: float,
    env: Mapping[str, str] | None = None,
) -> subprocess.CompletedProcess[str]:
    try:
        if env is not None:
            return host.run(list(arguments), timeout=timeout, env=env)
        return host.run(list(arguments), timeout=timeout)
    except FileNotFoundError:
        raise InstallError(f"{arguments[0]} is not installed") from None
    except subprocess.TimeoutExpired:
        command = " ".join(arguments[:4])
        raise InstallError(f"{command} did not finish within {timeout:g}s") from None


def _check(
    host: Host, arguments: Sequence[str], what: str, *, timeout: float,
) -> subprocess.CompletedProcess[str]:
    result = _run(host, arguments, timeout=timeout)
    if result.returncode != 0:
        raise InstallError(f"{what} failed (exit {result.returncode}){_detail(result.stderr)}")
    return result


def _json_output(host: Host, arguments: Sequence[str], what: str, *, timeout: float = 120) -> Any:
    result = _check(host, arguments, what, timeout=timeout)
    try:
        return json.loads(result.stdout or "null")
    except json.JSONDecodeError:
        raise InstallError(f"{what} did not print JSON") from None


def _entries(value: object) -> list[dict[str, Any]]:
    """The objects in a JSON listing; Podman prints null for an empty one."""
    return [entry for entry in value if isinstance(entry, dict)] if isinstance(value, list) else []


def _single(value: object, key: str, name: str, what: str) -> dict[str, Any]:
    entries = _entries(value)
    if len(entries) != 1 or entries[0].get(key) != name:
        raise InstallError(f"{what} did not describe exactly {name}")
    return entries[0]


# -- files -------------------------------------------------------------------------------------


def _read_regular(path: Path) -> bytes:
    """A regular file's bytes, never through a symbolic link."""
    try:
        descriptor = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC | os.O_NONBLOCK)
    except OSError as error:
        if error.errno == errno.ELOOP:
            raise InstallError(f"{path} is a symbolic link; refusing to use it") from None
        raise
    with os.fdopen(descriptor, "rb") as handle:
        if not stat.S_ISREG(os.fstat(handle.fileno()).st_mode):
            raise InstallError(f"{path} is not a regular file; refusing to use it")
        return handle.read()


def _file_digest(path: Path) -> str | None:
    """The sha256 of a regular file, or None when nothing is there; anything else is refused."""
    try:
        content = _read_regular(path)
    except FileNotFoundError:
        return None
    except OSError as error:
        raise InstallError(f"cannot read {path}: {error.strerror}") from None
    return hashlib.sha256(content).hexdigest()


def _sync_directory(path: Path) -> None:
    descriptor = os.open(path, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
    try:
        os.fsync(descriptor)
    finally:
        os.close(descriptor)


def _write_new(path: Path, content: bytes, mode: int) -> None:
    """Create ``path`` (O_EXCL, never through a link) with ``mode``, write it and sync it."""
    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC
    descriptor = os.open(path, flags, mode)
    try:
        try:
            os.fchmod(descriptor, mode)
            view = memoryview(content)
            while view:
                view = view[os.write(descriptor, view):]
            os.fsync(descriptor)
        finally:
            os.close(descriptor)
    except BaseException:
        with contextlib.suppress(FileNotFoundError):
            os.unlink(path)
        raise


def _write_atomic(path: Path, content: bytes, mode: int) -> None:
    """Replace ``path``: an O_EXCL temporary in the same directory, fsync, then rename."""
    temporary = path.with_name(f".{path.name}.{secrets.token_hex(8)}.tmp")
    _write_new(temporary, content, mode)
    try:
        os.rename(temporary, path)
    except BaseException:
        with contextlib.suppress(FileNotFoundError):
            os.unlink(temporary)
        raise
    _sync_directory(path.parent)


def save_state(paths: Paths, state: State) -> None:
    text = json.dumps(dataclasses.asdict(state), indent=2, sort_keys=True) + "\n"
    _write_atomic(paths.state, text.encode("utf-8"), 0o600)


def load_state(paths: Paths, uid: int) -> State | None:
    try:
        info = paths.state.lstat()
    except FileNotFoundError:
        return None
    if not stat.S_ISREG(info.st_mode):
        raise InstallError(f"{paths.state} is not a regular file; refusing to read it")
    if info.st_uid != uid or stat.S_IMODE(info.st_mode) & 0o077:
        raise InstallError(f"{paths.state} must be yours with mode 0600; refusing to read it")
    try:
        data = json.loads(_read_regular(paths.state))
    except (UnicodeDecodeError, json.JSONDecodeError):
        raise InstallError(f"{paths.state} is not a readable record; it was not changed") from None
    return State.from_json(data)


def _check_directories(paths: Paths, uid: int, *, create: bool) -> None:
    """The installer's own directories must be real, the operator's, and mode 0700.

    Missing ones are created only with ``create``. A symbolic link is always refused, so
    nothing the installer writes can land anywhere else.
    """
    for directory in paths.private_directories():
        try:
            info = directory.lstat()
        except FileNotFoundError:
            if not create:
                continue
            directory.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
            directory.mkdir(mode=0o700)
            directory.chmod(0o700)
            info = directory.lstat()
        if stat.S_ISLNK(info.st_mode):
            raise InstallError(f"{directory} is a symbolic link; refusing to use it")
        if not stat.S_ISDIR(info.st_mode):
            raise InstallError(f"{directory} is not a directory")
        if info.st_uid != uid:
            raise InstallError(f"{directory} is not owned by you")
        if stat.S_IMODE(info.st_mode) != 0o700:
            raise InstallError(f"{directory} must have mode 0700")


@contextlib.contextmanager
def _locked(paths: Paths, *, shared: bool = False) -> Iterator[None]:
    """Hold the installer's lock: exclusive for changes, shared for reading the record."""
    if not paths.data.is_dir():
        raise InstallError("nothing is initialized yet; run aegis-podman init first")
    try:
        descriptor = os.open(
            paths.lock, os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600,
        )
    except OSError as error:
        if error.errno == errno.ELOOP:
            raise InstallError(f"{paths.lock} is a symbolic link; refusing to use it") from None
        raise
    try:
        if not stat.S_ISREG(os.fstat(descriptor).st_mode):
            raise InstallError(f"{paths.lock} is not a regular file")
        try:
            fcntl.flock(descriptor, (fcntl.LOCK_SH if shared else fcntl.LOCK_EX) | fcntl.LOCK_NB)
        except BlockingIOError:
            raise LockBusy(
                "another aegis-podman command is running; try again once it has finished"
            ) from None
        yield
    finally:
        os.close(descriptor)


def _accepted(record: Mapping[str, Any] | None) -> set[str]:
    """The hashes a recorded file may have: its own, and while a write settles, the old one."""
    if record is None:
        return set()
    return {value for value in (record.get("sha256"), record.get("previous")) if value}


def _confined(paths: Paths, path: Path) -> bool:
    """Whether ``path`` lies strictly inside one of the installer's own directories."""
    text = os.path.normpath(str(path))
    for root in paths.removable_roots():
        prefix = os.path.normpath(str(root))
        if text != prefix and os.path.commonpath([text, prefix]) == prefix:
            return True
    return False


def _check_replaceable(state: State, path: Path) -> None:
    """Refuse to overwrite a file the installer did not write, or one changed since."""
    current = _file_digest(path)
    if current is None:
        return
    record = state.files.get(str(path))
    if record is None:
        raise InstallError(
            f"{path} exists but aegis-podman did not write it; move it away first "
            "(it is never overwritten)"
        )
    if current not in _accepted(record):
        raise InstallError(
            f"{path} was changed since aegis-podman wrote it; restore it or move it away first"
        )


def _check_removable(paths: Paths, state: State, path: Path, *, force: bool) -> None:
    if not _confined(paths, path):
        raise InstallError(f"the record names {path}, outside aegis-podman's own directories")
    current = _file_digest(path)
    if current is None or force:
        return
    if current not in _accepted(state.files.get(str(path))):
        raise InstallError(
            f"{path} was changed since aegis-podman wrote it; restore it, or rerun with "
            "--force-recorded to remove it anyway"
        )


def _publish(paths: Paths, state: State, path: Path, content: bytes, kind: str, mode: int) -> bool:
    """Write one recorded file; True when its content changed.

    Until ``_settle`` runs, the record accepts both the old and the new hash, so an
    interruption at any point leaves a file that the record still covers.
    """
    current = _file_digest(path)
    new = hashlib.sha256(content).hexdigest()
    if current == new and stat.S_IMODE(path.lstat().st_mode) == mode:
        state.files[str(path)] = {"kind": kind, "sha256": new}
        return False
    entry: dict[str, Any] = {"kind": kind, "sha256": new}
    if current is not None:
        entry["previous"] = current
    state.files[str(path)] = entry
    save_state(paths, state)
    _write_atomic(path, content, mode)
    return current != new


def _settle(paths: Paths, state: State) -> None:
    for record in state.files.values():
        record.pop("previous", None)
    save_state(paths, state)


def _remove_recorded(paths: Paths, state: State, path: Path) -> None:
    if not _confined(paths, path):
        raise InstallError(f"the record names {path}, outside aegis-podman's own directories")
    with contextlib.suppress(FileNotFoundError):
        os.unlink(path)
    del state.files[str(path)]
    save_state(paths, state)


def _remove_tree(root: Path) -> None:
    """Remove a tree the installer created itself, read-only directories included."""
    try:
        info = root.lstat()
    except FileNotFoundError:
        return
    if not stat.S_ISDIR(info.st_mode):
        root.unlink()
        return
    pending = [root]
    while pending:
        directory = pending.pop()
        os.chmod(directory, 0o700)
        with os.scandir(directory) as entries:
            pending.extend(
                Path(entry.path) for entry in entries if entry.is_dir(follow_symlinks=False)
            )
    shutil.rmtree(root)


def _remove_empty_directories(root: Path) -> None:
    """Remove ``root`` and the directories below it that are empty; keep anything else."""
    if not root.is_dir() or root.is_symlink():
        return
    for directory, _, _ in os.walk(root, topdown=False):
        with contextlib.suppress(OSError):
            os.rmdir(directory)


def _leftovers(paths: Paths, prefix: str) -> list[Path]:
    """Temporary files an interrupted run left in the installer's own directories, and its
    unit-file temporaries in the unit directories."""
    found = []
    for directory, start in (
        *((path, ".") for path in paths.private_directories()),
        *((path, f".{prefix}") for path in paths.unit_directories()),
    ):
        with contextlib.suppress(FileNotFoundError, NotADirectoryError):
            found += [
                Path(entry.path) for entry in os.scandir(directory)
                if entry.name.startswith(start) and entry.name.endswith(TEMPORARY_SUFFIXES)
            ]
    return sorted(found)


# -- validation and preflight ------------------------------------------------------------------


def _release_argument(value: str, *, local_images: bool = False) -> str:
    """A published release; a test release literal only with the deployment test's images."""
    if RELEASE.fullmatch(value) is not None:
        return value
    if TEST_RELEASE.fullmatch(value) is not None:
        if local_images:
            return value
        raise InstallError(f"release {value!r} is a test release, which needs --local-images")
    raise InstallError(f"release {value!r} is not sha-<40 hex>, the tag CI publishes")


def _local_images_argument(value: str | None) -> dict[str, str] | None:
    """``role=<image ID>`` for each role: images already in local storage, used in place of a
    pull by the deployment test only."""
    if value is None:
        return None
    images: dict[str, str] = {}
    for item in value.split(","):
        role, separator, identifier = item.partition("=")
        if (
            not separator or role not in ROLES or role in images
            or LOCAL_IMAGE_ID.fullmatch(identifier) is None
        ):
            break
        images[role] = identifier
    else:
        if set(images) == set(ROLES):
            return images
    raise InstallError(
        f"--local-images must name each of {', '.join(ROLES[:-1])} and {ROLES[-1]} once, as "
        "role=<64 hex image ID>, separated by commas"
    )


def _refuse_test_option(option: str, prefix: str) -> None:
    if prefix == PRODUCTION_PREFIX:
        raise InstallError(
            f"{option} is for the deployment test only: it needs a --prefix other than "
            f"{PRODUCTION_PREFIX}"
        )


def _reader_type_argument(value: str | None, prefix: str) -> str:
    if value is None:
        return PRODUCTION_READER_TYPE
    if value not in READER_TYPES:
        raise InstallError(f"--reader-type must be {' or '.join(READER_TYPES)}")
    if value == TEST_READER_TYPE:
        _refuse_test_option(f"--reader-type {TEST_READER_TYPE}", prefix)
    return value


def _registry_argument(value: str) -> str:
    domain = value.partition("/")[0]
    if REGISTRY.fullmatch(value) is None or not (
        "." in domain or ":" in domain or domain == "localhost"
    ):
        raise InstallError(
            f"registry {value!r} must be a lowercase registry host and path, such as "
            f"{DEFAULT_REGISTRY}"
        )
    return value


def _scan_interval_argument(value: int | None) -> int | None:
    if value is not None and not 1 <= value <= MAX_SCAN_INTERVAL_HOURS:
        raise InstallError(
            f"--scan-interval-hours must be between 1 and {MAX_SCAN_INTERVAL_HOURS}"
        )
    return value


def _prefix_argument(value: str | None) -> str:
    prefix = PRODUCTION_PREFIX if value is None else value
    if PREFIX.fullmatch(prefix) is None:
        raise InstallError(f"--prefix {prefix!r} must match {PREFIX.pattern}")
    return prefix


def _port_argument(port: int) -> int:
    if not MINIMUM_PORT <= port <= 65535:
        raise InstallError(
            f"--https-port must be between {MINIMUM_PORT} and 65535: no privileged ports"
        )
    return port


def _names_argument(names: Sequence[str], addresses: Sequence[str]) -> list[str]:
    for address in addresses:
        try:
            ipaddress.ip_address(address)
        except ValueError:
            raise InstallError(f"--address {address!r} is not an IP address") from None
    chosen = [*names, *addresses]
    try:
        hosts = [_host(name) for name in chosen]
    except RenderError as error:
        raise InstallError(str(error)) from None
    if len(set(hosts)) != len(hosts):
        raise InstallError("--name and --address values must not repeat")
    return chosen


def _subnet_argument(value: str | None) -> str | None:
    if value is None:
        return None
    try:
        return str(_backend_subnet(value))
    except RenderError as error:
        raise InstallError(f"--backend-subnet: {error}") from None


def _preflight(host: Host, paths: Paths) -> None:
    """Rootless Podman with SELinux enforcing, systemd 254 or newer, Quadlet, linger, and a
    user manager that reads units from the configuration home the installer writes to."""
    info = _json_output(host, [*PODMAN, "info", "--format", "json"], "podman info")
    security = info.get("host", {}).get("security", {}) if isinstance(info, dict) else {}
    if not isinstance(security, dict) or security.get("rootless") is not True:
        raise InstallError("Podman is not running rootless; run aegis-podman as the operator")
    if security.get("selinuxEnabled") is not True:
        raise InstallError("SELinux is not enabled; this deployment needs it enforcing")
    try:
        enforcing = host.selinux_enforce.read_text(encoding="ascii").strip() == "1"
    except OSError:
        enforcing = False
    if not enforcing:
        raise InstallError("SELinux is not enforcing; this deployment needs it enforcing")
    version = _check(host, ["systemctl", "--version"], "systemctl --version", timeout=60).stdout
    match = re.match(r"systemd (\d+)\b", version)
    if match is None:
        raise InstallError("cannot read the systemd version from systemctl --version")
    if int(match.group(1)) < MINIMUM_SYSTEMD:
        raise InstallError(
            f"systemd {match.group(1)} is too old; the units need {MINIMUM_SYSTEMD} or newer"
        )
    if not (host.quadlet.is_file() and os.access(host.quadlet, os.X_OK)):
        raise InstallError(f"Podman's Quadlet generator {host.quadlet} is missing")
    linger = _check(
        host, ["loginctl", "show-user", str(host.uid), "--property=Linger", "--value"],
        "loginctl show-user", timeout=60,
    ).stdout.strip()
    if linger != "yes":
        raise InstallError(
            "linger is off for your account, so the units would stop when you log out and "
            "would not start at boot. Turn it on as yourself (for your own account it needs "
            "no sudo): loginctl enable-linger; then rerun this command"
        )
    environment = _check(
        host, [*SYSTEMCTL, "show-environment"], "systemctl --user show-environment", timeout=60,
    ).stdout
    manager = dict(line.partition("=")[::2] for line in environment.splitlines() if "=" in line)
    value = manager.get("XDG_CONFIG_HOME", "")
    reads = Path(os.path.normpath(value)) if os.path.isabs(value) else host.home / ".config"
    if reads != paths.config:
        raise InstallError(
            f"your systemd user manager reads units under {reads}, but aegis-podman would "
            f"write them under {paths.config}; run it with the same XDG_CONFIG_HOME"
        )


def _containers(host: Host) -> list[dict[str, Any]]:
    return _entries(_json_output(host, [*PODMAN, "ps", "-a", "--format", "json"], "podman ps"))


def _check_port(host: Host, port: int, containers: Iterable[Mapping[str, Any]]) -> None:
    """The socket's port must have no listener and no container port mapping (spec D7)."""
    if host.port_in_use(port):
        raise InstallError(f"port {port} already has a listener; choose a free port")
    for container in containers:
        name = ", ".join(container.get("Names") or []) or str(container.get("Id", "?"))[:12]
        for mapping in container.get("Ports") or []:
            try:
                first = int(mapping["host_port"])
                count = max(int(mapping.get("range") or 1), 1)
            except (KeyError, TypeError, ValueError):
                continue
            if first <= port < first + count:
                raise InstallError(f"port {port} is mapped by container {name}; choose another")


# -- the backend subnet ------------------------------------------------------------------------


def _network(value: object) -> Network | None:
    """A routed network, or None for anything unreadable or default-like.

    Prefixes of length 0 and 1 are default routes, including the split pair (0.0.0.0/1 and
    128.0.0.0/1) a full-tunnel VPN installs; they do not make a private subnet unusable.
    """
    if not isinstance(value, str) or value == "default":
        return None
    try:
        network = ipaddress.ip_network(value, strict=False)
    except ValueError:
        return None
    return network if network.prefixlen > 1 else None


def _taken_networks(host: Host) -> list[tuple[Network, str]]:
    """Every subnet of every Podman network and every host route in any routing table."""
    taken: list[tuple[Network, str]] = []
    listed = _entries(
        _json_output(host, [*PODMAN, "network", "ls", "--format", "json"], "podman network ls")
    )
    names = [str(entry.get("name") or entry.get("Name")) for entry in listed]
    if names:
        inspected = _json_output(
            host, [*PODMAN, "network", "inspect", *names], "podman network inspect",
        )
        for entry in _entries(inspected):
            for subnet in _entries(entry.get("subnets")):
                if (network := _network(subnet.get("subnet"))) is not None:
                    taken.append((network, f"Podman network {entry.get('name')}"))
    for family in ("-4", "-6"):
        arguments = ["ip", "-j", family, "route", "show", "table", "all"]
        result = _run(host, arguments, timeout=60)
        if result.returncode != 0:
            if family == "-6":
                continue  # a host without IPv6 has no IPv6 routes to collide with
            raise InstallError(f"ip -4 route failed{_detail(result.stderr)}")
        try:
            routes = _entries(json.loads(result.stdout or "null"))
        except json.JSONDecodeError:
            raise InstallError("ip route did not print JSON") from None
        for route in routes:
            if (network := _network(route.get("dst"))) is not None:
                where = f"dev {route.get('dev', '?')}, table {route.get('table', 'main')}"
                taken.append((network, f"route {network} ({where})"))
    return taken


def _collides(candidate: ipaddress.IPv4Network, other: Network) -> bool:
    if isinstance(other, ipaddress.IPv6Network):
        mapped = other.network_address.ipv4_mapped
        if mapped is None or other.prefixlen < 96:
            return False
        other = ipaddress.IPv4Network(f"{mapped}/{other.prefixlen - 96}", strict=False)
    return candidate.overlaps(other)


def _choose_subnet(host: Host, requested: str | None) -> str:
    taken = _taken_networks(host)
    if requested is not None:
        candidate = ipaddress.IPv4Network(requested)
        clashes = [source for network, source in taken if _collides(candidate, network)]
        if clashes:
            raise InstallError(f"--backend-subnet {requested} overlaps {', '.join(clashes)}")
        return requested
    for candidate in SUBNET_CANDIDATES:
        if not any(_collides(candidate, network) for network, _ in taken):
            return str(candidate)
    clashes = sorted({
        source for network, source in taken
        if any(_collides(candidate, network) for candidate in SUBNET_CANDIDATES)
    })
    raise InstallError(
        f"no free private /24 for the backend network between {SUBNET_CANDIDATES[0]} and "
        f"{SUBNET_CANDIDATES[-1]}; they overlap {', '.join(clashes)}. Choose a free private "
        "/24 with --backend-subnet"
    )


def _check_backend_network(host: Host, state: State) -> None:
    """Refuse an existing backend network whose subnet is not the recorded one.

    Quadlet creates networks with ``--ignore``, so it would keep the stale network, and web's
    and the gateway's fixed addresses would not fit it.
    """
    name = f"{state.prefix}backend"
    exists = _run(host, [*PODMAN, "network", "exists", name], timeout=60)
    if exists.returncode == 1:
        return
    if exists.returncode != 0:
        raise InstallError(f"podman network exists {name} failed{_detail(exists.stderr)}")
    entry = _single(
        _json_output(host, [*PODMAN, "network", "inspect", name], "podman network inspect"),
        "name", name, "podman network inspect",
    )
    subnets = sorted(str(subnet.get("subnet")) for subnet in _entries(entry.get("subnets")))
    if subnets != [state.backend_subnet]:
        raise InstallError(
            f"the network {name} exists with subnet {', '.join(subnets) or 'none'}, but the "
            f"record says {state.backend_subnet}. Quadlet keeps an existing network as it is, "
            "so the fixed web and gateway addresses would not fit; if that network is Aegis's "
            f"own, stop Aegis and remove it with: podman network rm {name}"
        )


# -- images and release trees ------------------------------------------------------------------


def _created_time(value: object) -> datetime.datetime | None:
    """An RFC 3339 timestamp with a zone, or None when it is missing or unreadable."""
    if not isinstance(value, str) or (match := RFC3339.fullmatch(value)) is None:
        return None
    year, month, day, hour, minute, second, fraction, utc, sign, zone_h, zone_m = match.groups()
    try:
        if utc:
            zone = datetime.UTC
        else:
            offset = datetime.timedelta(hours=int(zone_h), minutes=int(zone_m))
            zone = datetime.timezone(-offset if sign == "-" else offset)
        return datetime.datetime(
            int(year), int(month), int(day), int(hour), int(minute), int(second),
            int((fraction or "0")[:6].ljust(6, "0")), tzinfo=zone,
        )
    except ValueError:
        return None


def _created_label(entry: Mapping[str, Any]) -> str | None:
    """An inspected image's org.opencontainers.image.created label, or None."""
    labels = entry.get("Labels") or (entry.get("Config") or {}).get("Labels") or {}
    value = labels.get(CREATED_LABEL) if isinstance(labels, dict) else None
    return value if isinstance(value, str) else None


def _pull(host: Host, registry: str, release: str) -> tuple[dict[str, str], str | None]:
    """Pull the release's images by tag and pin each to its registry digest.

    Also returns the backend image's creation label, which orders releases.
    """
    images = {}
    created: str | None = None
    for role in ROLES:
        repository = f"{registry}/aegis-{role}"
        tag = f"{repository}:{release}"
        _check(host, [*PODMAN, "pull", "--quiet", tag], f"pulling {tag}", timeout=1800)
        inspected = _entries(
            _json_output(host, [*PODMAN, "image", "inspect", tag], f"podman image inspect {tag}")
        )
        entry = inspected[0] if len(inspected) == 1 else {}
        digest = entry.get("Digest")
        reference = f"{repository}@{digest}"
        if not (
            isinstance(digest, str) and DIGEST.fullmatch(digest)
            and reference in (entry.get("RepoDigests") or []) and IMAGE.fullmatch(reference)
        ):
            raise InstallError(f"{tag} has no registry digest for {repository}; refusing it")
        images[role] = reference
        if role == "backend":
            created = _created_label(entry)
    return images, created


def _local(host: Host, images: Mapping[str, str]) -> tuple[dict[str, str], str | None]:
    """The deployment test's images, already in local storage, by ID: nothing is pulled.

    Also returns the backend image's creation label, as ``_pull`` does.
    """
    created: str | None = None
    for role in ROLES:
        identifier = images[role]
        result = _run(host, [*PODMAN, "image", "inspect", identifier], timeout=120)
        entries: list[dict[str, Any]] = []
        if result.returncode == 0:
            with contextlib.suppress(json.JSONDecodeError):
                entries = _entries(json.loads(result.stdout or "null"))
        if len(entries) != 1 or entries[0].get("Id") != identifier:
            raise InstallError(
                f"the {role} image {identifier} is not in local storage; build it first"
            )
        if role == "backend":
            created = _created_label(entries[0])
    return dict(images), created


def _check_order(state: State, release: str, created: str | None, allow: bool) -> None:
    """Refuse a release older than the current one, or one that cannot be ordered."""
    if allow:
        return
    new, current = _created_time(created), _created_time(state.created)
    hint = ("A downgrade does not reverse migrations: restore a matching database backup "
            "first, then rerun with --allow-downgrade")
    if new is None:
        raise InstallError(
            f"release {release} has no readable {CREATED_LABEL} label, so it cannot be "
            f"ordered against {state.release}. {hint}"
        )
    if current is None:
        raise InstallError(
            f"the current release {state.release} has no readable {CREATED_LABEL} label, so "
            f"{release} cannot be ordered against it. {hint}"
        )
    if new < current:
        raise InstallError(
            f"release {release} ({created}) is older than {state.release} ({state.created}), "
            f"so this is a downgrade. {hint}"
        )


def _container_id(cidfile: Path) -> str | None:
    with contextlib.suppress(OSError, InstallError, UnicodeDecodeError):
        text = _read_regular(cidfile).decode("ascii").strip()
        if CONTAINER_ID.fullmatch(text):
            return text
    return None


def _remove_extractions(host: Host, paths: Paths, state: State) -> None:
    """Remove the extraction containers that interrupted runs recorded by their ID files."""
    for recorded in list(state.extractions):
        cidfile = Path(recorded)
        container = _container_id(cidfile) if cidfile.parent == paths.data else None
        if container is not None:
            removed = _run(host, [*PODMAN, "rm", container], timeout=120)
            if removed.returncode not in (0, 1):  # 1: no such container
                raise InstallError(
                    f"could not remove the extraction container{_detail(removed.stderr)}; "
                    f"remove it with: podman rm {container}"
                )
        if cidfile.parent == paths.data:
            with contextlib.suppress(FileNotFoundError):
                cidfile.unlink()
        state.extractions.remove(recorded)
        save_state(paths, state)


def _copy_out(
    host: Host, paths: Paths, state: State, image: str, destination: Path,
    source: str = RELEASE_SOURCE,
) -> None:
    """Copy ``source`` out of ``image`` through a created, never started container.

    Podman writes the new container's ID to a file the record names before the container
    exists, so even an interrupted run leaves an exact ID to remove. That container, and
    only it, is removed on every path.
    """
    _remove_extractions(host, paths, state)
    cidfile = paths.data / f".extract.{secrets.token_hex(8)}.cid"
    state.extractions.append(str(cidfile))
    save_state(paths, state)
    created = _run(
        host,
        [*PODMAN, "create", "--pull=never", "--network=none", f"--cidfile={cidfile}", image,
         "python3"],
        timeout=300,
    )
    printed = created.stdout.strip()
    container = _container_id(cidfile) or (printed if CONTAINER_ID.fullmatch(printed) else None)
    if container is None:
        detail = _detail(created.stderr) if created.returncode else f": {printed[:200]!r}"
        raise InstallError(f"podman create gave no container ID{detail}")
    try:
        copied = (
            _run(host, [*PODMAN, "cp", f"{container}:{source}", str(destination)], timeout=300)
            if created.returncode == 0 else created
        )
    finally:
        removed = _run(host, [*PODMAN, "rm", container], timeout=120)
        if removed.returncode == 0:
            with contextlib.suppress(FileNotFoundError):
                cidfile.unlink()
            state.extractions.remove(str(cidfile))
            save_state(paths, state)
        else:
            print(
                "aegis-podman: warning: could not remove the extraction container"
                f"{_detail(removed.stderr)}; remove it with: podman rm {container}",
                file=host.err,
            )
    if created.returncode != 0:
        raise InstallError(
            f"podman create from {image} failed (exit {created.returncode})"
            f"{_detail(created.stderr)}"
        )
    if copied.returncode != 0:
        raise InstallError(
            f"copying {source} out of {image} failed (exit {copied.returncode})"
            f"{_detail(copied.stderr)}"
        )
    if removed.returncode != 0:
        raise InstallError(f"could not remove the extraction container: podman rm {container}")


def _walk_tree(root: Path, *, normalize: bool, what: str) -> dict[str, bytes]:
    """Every regular file under a tree the installer copied or rendered, by relative path.

    Symbolic links and special files are refused. With ``normalize`` (a fresh copy, which
    the image ships read-only), directories become 0700 and files 0600: a private tree the
    operator can later remove.
    """
    try:
        info = root.lstat()
    except FileNotFoundError:
        raise InstallError(f"{what} {root} is missing") from None
    if not stat.S_ISDIR(info.st_mode):
        raise InstallError(f"{what} {root} is not a directory")
    contents: dict[str, bytes] = {}
    pending = [(root, "")]
    while pending:
        directory, prefix = pending.pop()
        if normalize:
            os.chmod(directory, 0o700)
        with os.scandir(directory) as entries:
            for entry in sorted(entries, key=lambda item: item.name):
                relative = f"{prefix}{entry.name}"
                if entry.is_symlink():
                    raise InstallError(f"{what} holds a symbolic link, {relative}; refusing it")
                if entry.is_dir(follow_symlinks=False):
                    pending.append((Path(entry.path), f"{relative}/"))
                elif entry.is_file(follow_symlinks=False):
                    if normalize:
                        os.chmod(entry.path, 0o600)
                    contents[relative] = _read_regular(Path(entry.path))
                else:
                    raise InstallError(f"{what} holds a special file, {relative}; refusing it")
    return contents


def _drop_bytecode(root: Path) -> None:
    """Remove the compiled bytecode (``__pycache__`` directories, ``.pyc`` files) a package
    copied out of an image carries, leaving its source. Links are left for the walk to refuse.
    """
    pending = [root]
    while pending:
        directory = pending.pop()
        os.chmod(directory, 0o700)
        with os.scandir(directory) as scanned:
            entries = list(scanned)
        for entry in entries:
            if entry.is_symlink():
                continue
            if entry.is_dir(follow_symlinks=False):
                if entry.name == "__pycache__":
                    _remove_tree(Path(entry.path))
                else:
                    pending.append(Path(entry.path))
            elif entry.name.endswith(".pyc") and entry.is_file(follow_symlinks=False):
                os.unlink(entry.path)


def _scan_tree(root: Path, *, normalize: bool) -> dict[str, bytes]:
    """Every regular file under a release tree, which must hold the installer and templates."""
    contents = _walk_tree(root, normalize=normalize, what="the release tree")
    if RELEASE_INSTALLER not in contents or not any(
        name.startswith(f"{RELEASE_TEMPLATES}/") for name in contents
    ):
        raise InstallError(
            f"the release tree lacks {RELEASE_INSTALLER} or its {RELEASE_TEMPLATES}/ templates"
        )
    return contents


def _forget_release(state: State, release: str) -> None:
    """Drop a lost release directory's records: its tree and its aegisctl copy."""
    state.releases.pop(release, None)
    for path in [
        path for path, record in state.files.items()
        if record.get("kind") in ("release", "lib") and record.get("release") == release
    ]:
        del state.files[path]


def _extract_release(
    host: Host, paths: Paths, state: State, release: str, backend_image: str,
) -> None:
    """Make ``releases/<release>/podman`` hold that release's installer and templates.

    The tree comes from the release's backend image by digest. It is recorded file by file
    before it appears under its final name, and a recorded tree is verified, not copied again.
    """
    directory = paths.releases / release
    recorded = state.releases.get(release)
    if recorded is not None:
        if recorded.get("backend_image") != backend_image:
            raise InstallError(
                f"release {release} was recorded from {recorded.get('backend_image')}, but its "
                f"tag now resolves to {backend_image}; a published release tag must not move"
            )
        if os.path.lexists(directory):
            _verified_tree(paths, state, release)
            return
        _forget_release(state, release)  # lost or never published: copy it out again
    elif os.path.lexists(directory):
        raise InstallError(f"{directory} exists but is not recorded by aegis-podman; move it")
    staging = paths.releases / f".{release}.{secrets.token_hex(8)}.partial"
    staging.mkdir(mode=0o700)
    try:
        _copy_out(host, paths, state, backend_image, staging / "podman")
        contents = _scan_tree(staging / "podman", normalize=True)
        final = directory / "podman"
        state.releases[release] = {"backend_image": backend_image}
        for relative, content in contents.items():
            state.files[str(final / relative)] = {
                "kind": "release", "release": release,
                "sha256": hashlib.sha256(content).hexdigest(),
            }
        save_state(paths, state)
        os.rename(staging, directory)
    except BaseException:
        _remove_tree(staging)
        raise
    _sync_directory(paths.releases)


def _verified_tree(paths: Paths, state: State, release: str) -> dict[str, bytes]:
    tree = paths.release_tree(release)
    with contextlib.suppress(FileNotFoundError):
        if not stat.S_ISDIR((paths.releases / release).lstat().st_mode):
            raise InstallError(f"{paths.releases / release} is not a directory; refusing it")
    expected = {}
    for path, record in state.files.items():
        if record.get("kind") == "release" and record.get("release") == release:
            expected[posixpath.relpath(path, str(tree))] = record.get("sha256")
    contents = _scan_tree(tree, normalize=False)
    actual = {name: hashlib.sha256(content).hexdigest() for name, content in contents.items()}
    if not expected or actual != expected:
        raise InstallError(f"the release tree {tree} differs from its record; refusing to use it")
    return contents


def _release_renderer(
    paths: Paths, state: State, release: str,
) -> tuple[types.ModuleType, dict[str, str]]:
    """The release's own renderer and templates, from the bytes just verified."""
    contents = _verified_tree(paths, state, release)
    tree = paths.release_tree(release)
    name = f"aegis_podman_release_{release.replace('-', '_')}"
    module = types.ModuleType(name)
    module.__file__ = str(tree / RELEASE_INSTALLER)
    # Dataclasses resolve string annotations through sys.modules while the classes are built.
    sys.modules[name] = module
    try:
        exec(compile(contents[RELEASE_INSTALLER], module.__file__, "exec"), module.__dict__)
    except Exception as error:
        raise InstallError(f"cannot load the renderer of release {release}: {error}") from None
    finally:
        del sys.modules[name]
    if getattr(module, "RENDER_API", None) not in RENDER_APIS:
        raise InstallError(
            f"release {release} has a renderer this installer does not understand; "
            "run that release's own aegis-podman"
        )
    templates = {}
    try:
        for relative, content in contents.items():
            directory, _, file_name = relative.partition("/")
            if directory == RELEASE_TEMPLATES and "/" not in file_name:
                templates[file_name] = content.decode("utf-8")
    except UnicodeDecodeError:
        raise InstallError(f"a template of release {release} is not UTF-8") from None
    return module, templates


def _render(
    module: types.ModuleType, templates: Mapping[str, str], state: State, paths: Paths,
) -> dict[str, RenderedUnit]:
    """Render with the release's renderer and templates; place each unit where it belongs.

    A release before the media processor (render API 1) takes neither the media image, a
    derivatives directory nor the shared level; its units get random levels and a plain
    derivatives volume. A release before the scan interval (render API 2 or older) scans
    hourly.
    """
    try:
        values: dict[str, Any] = {
            "prefix": state.prefix, "release": state.release, "https_port": state.https_port,
            "names": tuple(state.names), "host_gid": state.host_gid,
            "reader_type": state.reader_type,
            "image_backend": state.images["backend"], "image_gateway": state.images["gateway"],
            "image_postgres": state.images["postgres"], "image_caddy": state.images["caddy"],
            "secrets_dir": str(paths.secrets), "backend_subnet": state.backend_subnet,
            "install_token": state.install_token, "install_sections": state.install_sections,
            "allow_test_values": state.local_images,
        }
        if module.RENDER_API >= 2:
            values["image_media"] = state.images["media"]
            usable = _usable_derivatives(state)
            values["derivatives_dir"] = None if usable is None else usable["path"]
            values["label_level"] = state.label_level
        if _takes_scan_interval(module):
            values["scan_interval_seconds"] = _scan_interval_hours(state) * 3600
        config = module.UnitConfig(**values)
        texts = module.render_units(config, templates)
        units = {}
        for name, text in texts.items():
            directory = module.unit_directory(name)
            if (
                directory not in INSTALL_DIRECTORIES or "/" in name
                or not name.startswith(state.prefix) or not isinstance(text, str)
            ):
                raise InstallError(f"the release renderer produced an unexpected unit {name!r}")
            units[name] = RenderedUnit(name, paths.config / directory / name, text)
    except (KeyError, TypeError, ValueError) as error:
        raise InstallError(f"the release's renderer refused this configuration: {error}") from None
    return units


# -- units ---------------------------------------------------------------------------------


def _unit_sections(text: str) -> dict[str, list[tuple[str, str]]]:
    sections: dict[str, list[tuple[str, str]]] = {}
    current: list[tuple[str, str]] | None = None
    for line in text.splitlines():
        stripped = line.strip()
        if not stripped or stripped.startswith(("#", ";")):
            continue
        if stripped.startswith("[") and stripped.endswith("]"):
            current = sections.setdefault(stripped[1:-1], [])
            continue
        key, separator, value = stripped.partition("=")
        if current is None or not separator:
            raise InstallError(f"cannot read the unit line {stripped[:80]!r}")
        current.append((key.strip(), value.strip()))
    return sections


def _values(sections: Mapping[str, list[tuple[str, str]]], section: str, key: str) -> list[str]:
    return [value for name, value in sections.get(section, []) if name == key]


def _one(sections: Mapping[str, list[tuple[str, str]]], section: str, key: str, unit: str) -> str:
    values = _values(sections, section, key)
    if len(values) != 1:
        raise InstallError(f"{unit} must set [{section}] {key} exactly once")
    return values[0]


def _systemd_unit(file_name: str) -> str:
    """The systemd unit a unit file becomes (Quadlet's naming for its own unit types)."""
    stem, _, suffix = file_name.rpartition(".")
    return {"container": f"{stem}.service", "network": f"{stem}-network.service",
            "volume": f"{stem}-volume.service"}.get(suffix, file_name)


def _inventory(
    units: Mapping[str, RenderedUnit],
) -> tuple[dict[str, Any], list[str], list[str]]:
    """The systemd units, containers, images, volumes and networks a rendering defines."""
    record: dict[str, Any] = {
        "files": sorted(units), "socket": None, "services": [], "oneshots": [],
        "generated": [], "containers": {}, "health_checked": [], "images": {},
    }
    volumes: list[str] = []
    networks: list[str] = []
    for name, unit in sorted(units.items()):
        sections = _unit_sections(unit.text)
        service = _systemd_unit(name)
        if name.endswith(".socket"):
            if record["socket"] is not None:
                raise InstallError("the release renders more than one socket")
            record["socket"] = name
        elif name.endswith(".container"):
            record["containers"][service] = _one(sections, "Container", "ContainerName", name)
            record["images"][service] = _one(sections, "Container", "Image", name)
            oneshot = _values(sections, "Service", "Type") == ["oneshot"]
            record["oneshots" if oneshot else "services"].append(service)
            if _values(sections, "Container", "HealthCmd"):
                record["health_checked"].append(service)
        elif name.endswith(".volume"):
            volumes.append(_one(sections, "Volume", "VolumeName", name))
            record["generated"].append(service)
        elif name.endswith(".network"):
            networks.append(_one(sections, "Network", "NetworkName", name))
            record["generated"].append(service)
    if record["socket"] is None:
        raise InstallError("the release renders no socket")
    return record, volumes, networks


def _record_inventory(
    state: State, inventory: dict[str, Any], volumes: Sequence[str], networks: Sequence[str],
) -> None:
    state.units = inventory
    # Objects a release no longer renders stay recorded, so --purge-data still finds them.
    state.volumes = list(dict.fromkeys([*state.volumes, *volumes]))
    state.networks = list(dict.fromkeys([*state.networks, *networks]))


def _stale_units(state: State, units: Mapping[str, RenderedUnit]) -> list[Path]:
    rendered = {str(unit.path) for unit in units.values()}
    return [
        Path(path) for path, record in state.files.items()
        if record.get("kind") == "unit" and path not in rendered
    ]


def _check_units(
    paths: Paths, state: State, units: Mapping[str, RenderedUnit], stale: Sequence[Path],
) -> None:
    for unit in units.values():
        _check_replaceable(state, unit.path)
    for path in stale:
        _check_removable(paths, state, path, force=False)


def _write_units(
    host: Host, paths: Paths, state: State, units: Mapping[str, RenderedUnit],
    stale: Sequence[Path], timeout: float,
) -> set[str]:
    """Write the rendered units. Units the release dropped are stopped, then removed."""
    if stale:
        dropped = [_systemd_unit(path.name) for path in stale]
        # A unit systemd never loaded cannot be stopped; polling then sees it inactive.
        _run(host, [*SYSTEMCTL, "--no-block", "stop", *dropped], timeout=120)
        if not _await_stopped(host, dropped, timeout):
            raise InstallError(f"{', '.join(dropped)} did not stop; their files were kept")
    for directory in sorted({unit.path.parent for unit in units.values()}):
        directory.mkdir(mode=0o700, parents=True, exist_ok=True)
        if not directory.is_dir():
            raise InstallError(f"{directory} is not a directory")
    changed = set()
    for name, unit in sorted(units.items()):
        if _publish(paths, state, unit.path, unit.text.encode("utf-8"), "unit", 0o644):
            changed.add(name)
    for path in stale:
        _remove_recorded(paths, state, path)
    return changed


def _service_units(state: State) -> list[str]:
    return [state.units["socket"], *state.units["services"], *state.units["oneshots"]]


def _watched_units(state: State) -> list[str]:
    """Everything a start depends on: the socket, the services, and Quadlet's network and
    volume services, whose failure leaves the services that need them inactive."""
    return [*_service_units(state), *state.units["generated"]]


def _unit_states(host: Host, units: Sequence[str]) -> dict[str, dict[str, str]]:
    result = _check(
        host, [*SYSTEMCTL, "show", "--property=" + ",".join(UNIT_PROPERTIES), *units],
        "systemctl --user show", timeout=60,
    )
    found: dict[str, dict[str, str]] = {}
    for block in result.stdout.split("\n\n"):
        values = {}
        for line in block.splitlines():
            key, separator, value = line.partition("=")
            if separator:
                values[key] = value
        if "Id" in values:
            # systemctl leaves out a property that is empty, such as Job with no job queued.
            found[values["Id"]] = {"Job": ""} | values
    missing = {"LoadState": "not-found", "ActiveState": "inactive", "SubState": "dead",
               "Result": "success", "NRestarts": "0", "Job": ""}
    return {unit: found.get(unit, {"Id": unit, **missing}) for unit in units}


def _image_id(host: Host, reference: str, cache: dict[str, str]) -> str:
    """The local image ID ``reference`` resolves to, or "" when it resolves to none."""
    if reference not in cache:
        result = _run(host, [*PODMAN, "image", "inspect", "--format", "{{.Id}}", reference],
                      timeout=60)
        identifier = (result.stdout or "").strip() if result.returncode == 0 else ""
        cache[reference] = identifier if re.fullmatch(r"[0-9a-f]{64}", identifier) else ""
    return cache[reference]


def _observe(host: Host, state: State) -> dict[str, dict[str, str]]:
    """Each long-running service's container: its health and the image it runs.

    Whether a container runs its unit's image is decided by image ID. The reference Podman
    reports for a container (``ImageName``) is whichever name it resolved, such as a local
    tag, not necessarily the digest or ID the unit names.
    """
    observed = {}
    resolved: dict[str, str] = {}
    for service in state.units["services"]:
        container = state.units["containers"][service]
        result = _run(host, [*PODMAN, "container", "inspect", container], timeout=60)
        entries: list[dict[str, Any]] = []
        if result.returncode == 0:
            with contextlib.suppress(json.JSONDecodeError):
                entries = _entries(json.loads(result.stdout or "null"))
        if not entries:
            observed[service] = {"health": "absent", "image": ""}
            continue
        details = entries[0].get("State") or {}
        health = details.get("Health") or details.get("Healthcheck") or {}
        status = str(health.get("Status") or "unknown")
        expected = _image_id(host, state.units["images"].get(service, ""), resolved)
        running = str(entries[0].get("Image", ""))
        observed[service] = {
            "health": status if service in state.units["health_checked"] else "-",
            "image": str(entries[0].get("ImageName", "")) or running,
            "current": "yes" if expected and running == expected else "no",
        }
    return observed


def _readiness(
    state: State, states: Mapping[str, Mapping[str, str]],
    observed: Mapping[str, Mapping[str, str]], *, expect_running: bool,
) -> tuple[list[str], list[str]]:
    """The units still coming up, and the units that failed or were never started.

    With ``expect_running`` (a start was queued, or the operator wants Aegis running), a unit
    that is inactive with no job left has had its start job finish without starting it:
    something it needs failed. systemd reports that as nothing more than inactive.
    """
    pending, failed = [], []
    for unit, info in states.items():
        active = info.get("ActiveState")
        if info.get("LoadState") != "loaded" or active == "failed":
            failed.append(unit)
            continue
        if info.get("Job"):
            pending.append(unit)
            continue
        if active == "inactive":
            (failed if expect_running else pending).append(unit)
            continue
        ready = active == "active" and (
            info.get("SubState") == "running" if unit in state.units["services"] else True
        )
        seen = observed.get(unit)
        if ready and seen is not None:
            healthy = unit not in state.units["health_checked"] or seen["health"] == "healthy"
            ready = healthy and seen.get("current") == "yes"
        if not ready:
            pending.append(unit)
    return pending, failed


def _print_units(
    host: Host, state: State, states: Mapping[str, Mapping[str, str]],
    observed: Mapping[str, Mapping[str, str]],
) -> None:
    """One line per unit: what systemd and Podman report now."""
    width = max(len(unit) for unit in states)
    for unit, info in states.items():
        seen = observed.get(unit, {})
        image = seen.get("image")
        if image is None or not image:
            running = "-"
        elif seen.get("current") == "yes":
            running = "current"
        else:
            running = f"stale ({image})"
        _say(
            host,
            f"{unit:<{width}}  {info.get('ActiveState', '?')}/{info.get('SubState', '?')}"
            f"  result={info.get('Result', '?')}  restarts={info.get('NRestarts', '?')}"
            f"  job={info.get('Job') or '-'}  health={seen.get('health', '-')}  image={running}",
        )


def _scan_interval_text(state: State) -> str:
    if state.scan_interval_rendered:
        return f"scan interval {_scan_interval_hours(state)} h between scans of each root"
    later = (
        f"the first upgrade to a release that has it moves to {DEFAULT_SCAN_INTERVAL_HOURS} h "
        "and rescans every root once, unless --scan-interval-hours 1 keeps hourly scans"
        if state.scan_interval_hours is None else
        f"{state.scan_interval_hours} h applies at the next upgrade to a release that has it"
    )
    return f"scan interval 1 h (this release predates the setting); {later}"


def _print_status(
    host: Host, state: State, states: Mapping[str, Mapping[str, str]],
    observed: Mapping[str, Mapping[str, str]], failed: Sequence[str],
) -> None:
    _say(host, f"release {state.release} ({state.desired})")
    for role in ROLES:
        _say(host, f"  {role:<9} {state.images.get(role, '-')}")
    if state.derivatives is not None:
        _say(host, f"  derivatives in {state.derivatives['path']}" + (
            "" if state.derivatives["prepared"] else
            " (preparation unfinished, so nothing binds it; --derivatives-dir replaces it)"
        ))
    if state.label_level is not None:
        _say(host, f"  SELinux level {state.label_level}, shared by every container")
    _say(host, f"  {_scan_interval_text(state)}")
    unfinished = _migration_pending(state)
    if unfinished:
        _say(host, f"  volumes not yet relabelled to that level: {', '.join(unfinished)}; "
                   "the pending upgrade, or aegis-podman install, finishes it")
    for slot, root in sorted(state.roots.items()):
        _say(host, f"  root {slot}: {root['source']} ({root['selinux_type']})")
    if state.selinux_pending:
        _say(host, f"SELinux types the host setup has yet to load: "
                   f"{', '.join(state.selinux_pending)}; run aegis-podman host-setup and its "
                   "script, then roots add again")
    if state.pending is not None:
        release = state.pending["release"]
        _say(host, f"upgrade to {release} is pending; finish it with: aegis-podman upgrade "
                   f"--release {release}, or go back with: aegis-podman upgrade --abandon")
    _print_units(host, state, states, observed)
    broken = [
        unit for unit, info in states.items()
        if info.get("ActiveState") == "failed" or info.get("Result", "success") != "success"
        or info.get("LoadState") != "loaded"
    ]
    blocked = [unit for unit in failed if unit not in broken]
    if broken:
        _say(host, f"Failed: {', '.join(broken)}")
    if blocked:
        _say(host, f"Not started, because a unit they need failed: {', '.join(blocked)}")
    if broken or blocked:
        _say(host, "Recovery: read the logs, fix the cause, then clear and start again:")
        for unit in broken or blocked:
            _say(host, f"  journalctl --user -u {unit} --no-pager -n 200")
        _say(host, f"  systemctl --user reset-failed {' '.join([*broken, *blocked])}")
        _say(host, "  aegis-podman start")


def _await_ready(host: Host, state: State, timeout: float) -> bool:
    """Poll until every watched unit is active, healthy and on its recorded image, or fail at
    once when one failed or was never started."""
    deadline = host.monotonic() + timeout
    while True:
        states = _unit_states(host, _watched_units(state))
        observed = _observe(host, state)
        pending, failed = _readiness(state, states, observed, expect_running=True)
        if failed:
            print(f"aegis-podman: did not start: {', '.join(failed)}", file=host.err)
            _print_status(host, state, states, observed, failed)
            return False
        if not pending:
            return True
        if host.monotonic() >= deadline:
            print(
                f"aegis-podman: not ready within {timeout:g}s: {', '.join(pending)}",
                file=host.err,
            )
            _print_status(host, state, states, observed, failed)
            return False
        host.sleep(POLL_SECONDS)


def _await_stopped(host: Host, units: Sequence[str], timeout: float) -> bool:
    deadline = host.monotonic() + timeout
    while True:
        states = _unit_states(host, units)
        busy = [
            unit for unit, info in states.items()
            if info.get("Job") or info.get("ActiveState") not in ("inactive", "failed")
        ]
        if not busy:
            return True
        if host.monotonic() >= deadline:
            print(
                f"aegis-podman: not stopped within {timeout:g}s: {', '.join(busy)}",
                file=host.err,
            )
            return False
        host.sleep(POLL_SECONDS)


# -- objects -----------------------------------------------------------------------------------


def _object_labels(host: Host, kind: str, name: str) -> dict[str, Any] | None:
    """The labels of the volume or network ``name``, or None when it does not exist."""
    exists = _run(host, [*PODMAN, kind, "exists", name], timeout=60)
    if exists.returncode == 1:
        return None
    if exists.returncode != 0:
        raise InstallError(f"podman {kind} exists {name} failed{_detail(exists.stderr)}")
    inspected = _json_output(host, [*PODMAN, kind, "inspect", name], f"podman {kind} inspect")
    entry = _single(inspected, "Name" if kind == "volume" else "name", name, f"{kind} inspect")
    labels = entry.get("Labels") or entry.get("labels") or {}
    return labels if isinstance(labels, dict) else {}


def _refuse_existing_objects(
    host: Host, containers: Iterable[Mapping[str, Any]], inventory: Mapping[str, Any],
    volumes: Sequence[str], networks: Sequence[str],
) -> None:
    """Before anything exists, no container, volume or network may carry one of its names.

    Quadlet creates volumes and networks with ``--ignore``: it would adopt such an object.
    """
    existing = {name for entry in containers for name in entry.get("Names") or []}
    listed = _json_output(host, [*PODMAN, "volume", "ls", "--format", "json"], "podman volume ls")
    existing |= {str(entry.get("Name")) for entry in _entries(listed)}
    listed = _json_output(
        host, [*PODMAN, "network", "ls", "--format", "json"], "podman network ls",
    )
    existing |= {str(entry.get("name") or entry.get("Name")) for entry in _entries(listed)}
    clashes = sorted(
        name for name in [*inventory["containers"].values(), *volumes, *networks]
        if name in existing
    )
    if clashes:
        raise InstallError(
            "these Podman objects already exist and aegis-podman did not create them: "
            f"{', '.join(clashes)}; it never reuses or removes them"
        )


# -- secrets (spec D9) -------------------------------------------------------------------------


def _same_file(info: os.stat_result, record: Mapping[str, Any]) -> bool:
    # Device and inode alone are not enough: ext4 reuses a deleted file's inode for the next
    # new file. A finished secret's record also pins its change time, which any replacement,
    # chown or relabel moves.
    return (
        stat.S_ISREG(info.st_mode)
        and (info.st_dev, info.st_ino) == (record.get("device"), record.get("inode"))
        and ("ctime_ns" not in record or info.st_ctime_ns == record["ctime_ns"])
    )


def _lstat(path: Path) -> os.stat_result | None:
    try:
        return path.lstat()
    except FileNotFoundError:
        return None


def _secret_ready(paths: Paths, state: State, name: str) -> bool:
    """Whether ``name`` holds the installer's prepared secret; refuse anything else there.

    A recorded secret that is gone is created again: init runs before anything used the
    database secrets, and a lost bootstrap password is replaced and shown once more.
    """
    path = paths.secrets / name
    record = state.secrets.get(name)
    if record is not None and "pending" in record:
        final = _lstat(path)
        if final is not None and "device" in record and _same_file(final, record):
            # Renamed into place just before an interruption: it is complete.
            state.secrets[name] = {
                "device": record["device"], "inode": record["inode"],
                "ctime_ns": final.st_ctime_ns,
            }
            return True
        # Otherwise the creation never reached its name: drop exactly its own temporary.
        temporary = Path(record["pending"])
        info = _lstat(temporary) if temporary.parent == paths.secrets else None
        if info is not None and ("device" not in record or _same_file(info, record)):
            temporary.unlink()
        del state.secrets[name]
        record = None
    info = _lstat(path)
    if info is None:
        state.secrets.pop(name, None)
        return False
    if record is None or not _same_file(info, record):
        raise InstallError(
            f"{path} exists but aegis-podman did not create it; move it away first "
            "(secrets are never overwritten)"
        )
    return True


def _new_secret(host: Host, paths: Paths, state: State, name: str) -> str:
    """Create one secret file and return its value, which goes nowhere else.

    The value is 32 random bytes, hex-encoded. The temporary name is recorded before the
    file exists. The file is prepared under it (O_EXCL, O_NOFOLLOW, mode 0600, labeled
    container_file_t, then owned by the container user, neither tool following a link) and
    renamed into place last, so a secret under its name is always complete.
    """
    path = paths.secrets / name
    temporary = path.with_name(f".{name}.{secrets.token_hex(8)}.tmp")
    state.secrets[name] = {"pending": str(temporary)}
    save_state(paths, state)
    value = secrets.token_hex(32)
    _write_new(temporary, f"{value}\n".encode("ascii"), 0o600)
    info = temporary.lstat()
    identity = {"device": info.st_dev, "inode": info.st_ino}
    state.secrets[name] = {"pending": str(temporary), **identity}
    save_state(paths, state)
    _check(
        host, [*CONTAINER_FILE_LABEL, str(temporary)],
        f"labelling the secret {name}", timeout=60,
    )
    _check(
        host, [*PODMAN, "unshare", "chown", "-h", SECRET_OWNER, str(temporary)],
        f"handing the secret {name} to the container user", timeout=60,
    )
    if os.path.lexists(path):
        raise InstallError(f"{path} appeared while it was being created; refusing to replace it")
    os.rename(temporary, path)
    _sync_directory(paths.secrets)
    final = path.lstat()
    if not _same_file(final, identity):
        raise InstallError(f"{path} changed while it was being created; refusing it")
    state.secrets[name] = {**identity, "ctime_ns": final.st_ctime_ns}
    save_state(paths, state)
    return value


def prepare_for_mapped_containers(host: Host, path: Path) -> None:
    """Make ``path`` a file the group-mapped containers read as 10001:10001 with mode 0600.

    It sets mode 0600, labels the file container_file_t, then hands it to container uid 10001
    and the operator's group (``podman unshare chown 10001:0``), which those containers map to
    gid 10001. Secrets differ only in their group: they are 10001:10001 in the default mapping.
    Neither tool follows a symbolic link, and a link or special file is refused.
    """
    try:
        descriptor = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC | os.O_NONBLOCK)
    except OSError as error:
        if error.errno == errno.ELOOP:
            raise InstallError(f"{path} is a symbolic link; refusing it") from None
        raise
    try:
        if not stat.S_ISREG(os.fstat(descriptor).st_mode):
            raise InstallError(f"{path} is not a regular file; refusing it")
        os.fchmod(descriptor, 0o600)
    finally:
        os.close(descriptor)
    _check(host, [*CONTAINER_FILE_LABEL, str(path)], f"labelling {path}", timeout=60)
    _check(host, [*PODMAN, "unshare", "chown", "-h", MAPPED_OWNER, str(path)],
           f"handing {path} to the mapped container user", timeout=60)


# -- the derivatives directory (spec M8) -----------------------------------------------------


def _derivatives_argument(value: str) -> str:
    """A derivatives directory as the units and Podman read it: absolute, normalized, literal."""
    try:
        return _derivatives_dir(value)
    except RenderError:
        raise InstallError(
            f"--derivatives-dir {value!r} must be an absolute, normalized path whose components "
            "are letters, digits and ._@+-, so that Quadlet, systemd and Podman read it "
            "literally"
        ) from None


def _derivatives_moved(recorded: str, requested: str) -> str:
    return (
        f"the derivatives directory is {recorded}, not {requested}; aegis-podman never moves "
        "derivatives to another directory (that would need a --move-derivatives, which does "
        f"not exist), so it keeps the recorded one: leave out --derivatives-dir, or give "
        f"{shlex.quote(recorded)}"
    )


def _unescape_mountinfo(value: str) -> str:
    return re.sub(r"\\([0-7]{3})", lambda match: chr(int(match.group(1), 8)), value)


def _filesystem_type(host: Host, path: str) -> tuple[str, str]:
    """The type and mount point of the file system that holds ``path`` (a real, absolute
    path), from the installer's own mount table: the deepest mount point that contains it, and
    of two at the same point the one mounted last."""
    try:
        text = host.mountinfo.read_text(encoding="utf-8", errors="surrogateescape")
    except OSError as error:
        raise InstallError(f"cannot read {host.mountinfo}: {error.strerror}") from None
    found: tuple[str, str] | None = None
    for line in text.splitlines():
        # id parent major:minor root mountpoint options [optional fields] - type source ...
        fields = line.split(" ")
        try:
            separator = fields.index("-", 6)
            mountpoint, kind = _unescape_mountinfo(fields[4]), fields[separator + 1]
        except (ValueError, IndexError):
            continue
        if not mountpoint.startswith("/"):
            continue
        inside = path == mountpoint or path.startswith(mountpoint.rstrip("/") + "/")
        if inside and (found is None or len(mountpoint) >= len(found[1])):
            found = (kind, mountpoint)
    if found is None:
        raise InstallError(f"{host.mountinfo} names no mount that holds {path}")
    return found


def _prepared_for_containers(host: Host, path: str) -> bool:
    """Whether ``path`` already is what ``_prepare_derivatives`` makes of a directory (owned
    by container uid 10001 and the operator's group, mode 2770): a run interrupted between the
    preparation and the record left it so, and the operator can no longer own it again."""
    result = _run(host, [*PODMAN, "unshare", "stat", "--format=%u:%g:%a", "--", path],
                  timeout=60)
    return result.returncode == 0 and (result.stdout or "").strip() == (
        f"{MAPPED_OWNER}:{DERIVATIVES_MODE:o}"
    )


def _check_derivatives_directory(
    host: Host, paths: Paths, state: State, path: str, record: Mapping[str, Any] | None,
) -> os.stat_result:
    """The derivatives directory must already be a real directory reached through no symbolic
    link, apart from every root and every directory of the installer (by path and by device
    and inode), on a file system that keeps its content. Adopted (no ``record``) it must also
    be empty, the operator's own (or already prepared by an interrupted adoption), and not a
    mount point itself, so that a disk missing at boot leaves Podman nothing to bind. A
    recorded one must still be that same directory. aegis-podman never creates it."""
    try:
        info = os.lstat(path)
    except FileNotFoundError:
        raise InstallError(
            f"{path} does not exist; aegis-podman never creates the derivatives directory, so "
            "create it first: an empty directory of your own, outside every root"
        ) from None
    except OSError as error:
        raise InstallError(f"cannot inspect {path}: {error.strerror}") from None
    if stat.S_ISLNK(info.st_mode):
        raise InstallError(f"{path} is a symbolic link; give the directory it points to")
    if not stat.S_ISDIR(info.st_mode):
        raise InstallError(f"{path} is not a directory")
    real = os.path.realpath(path)
    if real != path:
        raise InstallError(f"{path} is reached through a symbolic link; give its real path, "
                           f"{shlex.quote(real)}")
    if record is not None:
        if (info.st_dev, info.st_ino) != (record["device"], record["inode"]):
            raise InstallError(
                f"{path} is no longer the derivatives directory aegis-podman prepared (its "
                "device and inode changed); mount or put that directory back"
            )
    else:
        if info.st_uid != host.uid and not _prepared_for_containers(host, path):
            raise InstallError(f"{path} is not owned by you; the derivatives directory must "
                               "be a directory of your own")
        try:
            entries = os.listdir(path)
        except OSError as error:
            raise InstallError(f"cannot list {path}: {error.strerror}") from None
        if entries:
            raise InstallError(f"{path} is not empty; the derivatives directory must start "
                               "empty, so create a new one")
    for directory in (paths.data, paths.config_directory, *paths.unit_directories()):
        if not _apart(real, info, directory):
            raise InstallError(
                f"{path} overlaps aegis-podman's own directory {directory}; the derivatives "
                "directory must lie outside it, and it outside the derivatives directory"
            )
    for slot, root in sorted(state.roots.items()):
        if not _apart(real, info, root["source"]):
            raise InstallError(
                f"{path} overlaps the root {slot} ({root['source']}); originals stay "
                "read-only, so the derivatives directory must lie outside every root, and "
                "every root outside it"
            )
    kind, mountpoint = _filesystem_type(host, real)
    if kind in VOLATILE_FILESYSTEMS:
        raise InstallError(f"{path} is on {kind}, which keeps nothing across a reboot; choose "
                           "a directory on a disk")
    if record is None and mountpoint == real:
        raise InstallError(
            f"{path} is a mount point itself; give a directory inside it, so that if the disk "
            "is not mounted at boot there is nothing for Podman to bind"
        )
    return info


def _label_probe(host: Host, path: str) -> None:
    """Prove that files in ``path`` take the containers' label before anything changes: label
    a fresh file in it, then remove that file. A file system without SELinux labels, or one
    mounted with a fixed ``context=``, refuses."""
    probe = os.path.join(path, f".aegis-podman-label-probe.{secrets.token_hex(8)}")
    descriptor = os.open(probe, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW
                         | os.O_CLOEXEC, 0o600)
    os.close(descriptor)
    try:
        result = _run(host, [*CONTAINER_FILE_LABEL, probe], timeout=60)
    finally:
        with contextlib.suppress(FileNotFoundError):
            os.unlink(probe)
    if result.returncode != 0:
        raise InstallError(
            f"{path} cannot carry the SELinux label the containers read through (chcon -t "
            f"{CONTAINER_FILE_TYPE} -l s0 failed{_detail(result.stderr)}): its file system "
            "has no SELinux labels, or is mounted with a fixed context=. Nothing was "
            "recorded; choose a directory on a file system with SELinux labels"
        )


def _prepare_derivatives(host: Host, path: str) -> None:
    """Hand the derivatives directory to the group-mapped containers, as files are prepared
    for them: mode 2770, labelled container_file_t at s0, then owned by container uid 10001
    and the operator's group (``podman unshare chown 10001:0``), which the media worker and
    the gateway both map (D5). The setgid bit keeps that group on whatever the worker creates.
    Neither tool follows a symbolic link."""
    descriptor = os.open(path, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC)
    try:
        os.fchmod(descriptor, DERIVATIVES_MODE)
        kept = stat.S_IMODE(os.fstat(descriptor).st_mode)
    finally:
        os.close(descriptor)
    if kept != DERIVATIVES_MODE:
        raise InstallError(
            f"{path} did not keep mode {DERIVATIVES_MODE:o}: the setgid bit needs a group of "
            "yours, so change its group to your own (chgrp) and rerun"
        )
    _check(host, [*CONTAINER_FILE_LABEL, path], f"labelling {path}", timeout=60)
    _check(host, [*PODMAN, "unshare", "chown", "-h", MAPPED_OWNER, path],
           f"handing {path} to the mapped container user", timeout=60)


def _adopt_derivatives(host: Host, paths: Paths, state: State, path: str) -> dict[str, Any]:
    """Check ``path``, prove it takes the containers' label, prepare it, and return the record
    to keep. Nothing is recorded here: the caller records it only once the preparation is
    complete, so any failure leaves the record as it was and the operator free to choose
    again. A directory an interrupted adoption already prepared is taken as it is."""
    info = _check_derivatives_directory(host, paths, state, path, None)
    if info.st_uid == host.uid:
        _label_probe(host, path)
        _prepare_derivatives(host, path)
    return {"path": path, "device": info.st_dev, "inode": info.st_ino, "prepared": True}


def _usable_derivatives(state: State) -> dict[str, Any] | None:
    """The recorded derivatives directory, once its preparation finished. A record left
    unprepared by an earlier version binds nothing and may be replaced."""
    record = state.derivatives
    return record if record is not None and record["prepared"] else None


def _derivatives_bound(paths: Paths, state: State) -> bool:
    """Whether the installed units bind the recorded directory: the derivatives volume unit
    on disk names it. A release whose units do not (one before the bind form, or a stack not
    installed) is never held back by it, and the directory may still be replaced."""
    record = _usable_derivatives(state)
    if record is None or not state.installed:
        return False
    unit = paths.config / UNIT_DIRECTORIES[".volume"] / f"{state.prefix}{DERIVATIVES_VOLUME}.volume"
    try:
        lines = _read_regular(unit).decode("utf-8").splitlines()
    except (OSError, InstallError, UnicodeDecodeError):
        return False
    return f"Device={record['path']}" in (line.strip() for line in lines)


def _derivatives_request(host: Host, paths: Paths, state: State, path: str | None) -> bool:
    """Whether this upgrade adopts ``path``; refuse what it cannot do.

    The recorded directory is kept. Another one replaces it only while no installed unit
    binds it. A new directory replaces the derivatives volume, which Quadlet creates only when
    no volume of that name exists. So Aegis must be stopped and the volume absent: a release
    without the media processor created it, but never wrote it.
    """
    if path is None:
        return False
    record = _usable_derivatives(state)
    if record is not None and record["path"] == path:
        return False
    if record is not None and _derivatives_bound(paths, state):
        raise InstallError(_derivatives_moved(record["path"], path))
    if state.desired != "stopped":
        raise InstallError(
            "adopting a derivatives directory replaces the derivatives volume, so Aegis must "
            "be stopped first: run aegis-podman stop, then this command again"
        )
    name = f"{state.prefix}{DERIVATIVES_VOLUME}"
    if _object_labels(host, "volume", name) is not None:
        raise InstallError(
            f"the volume {name} already exists, and Quadlet keeps an existing volume as it is, "
            f"so it would never bind {path}. If it holds no derivatives yet (a release without "
            f"the media processor never writes it), remove it with: podman volume rm {name}; "
            "then run this command again. Derivatives already in it are never moved"
        )
    return True


def _check_derivatives(host: Host, paths: Paths, state: State, record: Mapping[str, Any]) -> None:
    """Before units that bind ``record``'s directory are installed, upgraded or started: it is
    still the same directory, and an existing derivatives volume binds exactly it (Quadlet
    keeps an existing volume as it is, so a plain one would stay plain)."""
    _check_derivatives_directory(host, paths, state, record["path"], record)
    name = f"{state.prefix}{DERIVATIVES_VOLUME}"
    exists = _run(host, [*PODMAN, "volume", "exists", name], timeout=60)
    if exists.returncode == 1:
        return
    if exists.returncode != 0:
        raise InstallError(f"podman volume exists {name} failed{_detail(exists.stderr)}")
    entry = _single(
        _json_output(host, [*PODMAN, "volume", "inspect", name], "podman volume inspect"),
        "Name", name, "podman volume inspect",
    )
    options = entry.get("Options") or {}
    if not (
        isinstance(options, dict) and options.get("device") == record["path"]
        and options.get("type") == "none" and options.get("o") == "bind"
    ):
        raise InstallError(
            f"the volume {name} exists but does not bind {record['path']}, and Quadlet keeps "
            "an existing volume as it is. If it holds no derivatives yet, stop Aegis "
            f"(aegis-podman stop), remove it with: podman volume rm {name}; then run this "
            "command again"
        )


def _renew_derivatives_volume(host: Host, state: State, timeout: float) -> None:
    """While Aegis is stopped, with a derivatives directory recorded and no volume yet: stop
    the volume's service, so the next start runs it and Quadlet creates the volume, now as
    the bind. A service still active from the old plain volume would never run again, and
    the containers would create a plain volume of their own."""
    if _usable_derivatives(state) is None:
        return
    if _object_labels(host, "volume", f"{state.prefix}{DERIVATIVES_VOLUME}") is not None:
        return
    unit = f"{state.prefix}{DERIVATIVES_VOLUME}-volume.service"
    _run(host, [*SYSTEMCTL, "--no-block", "stop", unit], timeout=120)
    if not _await_stopped(host, [unit], timeout):
        raise InstallError(f"{unit} did not stop; stop it with: systemctl --user stop {unit}")


# -- the shared SELinux level -----------------------------------------------------------------


def new_label_level(randbelow: Callable[[int], int] | None = None) -> str:
    """A random ``s0:cX,cY`` with distinct categories, the lower first, never the dev stacks'.

    Containers of one install share it; every other container, another install's included,
    draws its own, so MCS keeps them apart. ``randbelow`` defaults to ``secrets.randbelow``.
    """
    draw = secrets.randbelow if randbelow is None else randbelow
    while True:
        first, second = draw(MAX_CATEGORY + 1), draw(MAX_CATEGORY + 1)
        level = f"s0:c{min(first, second)},c{max(first, second)}"
        if first != second and level != DEV_LABEL_LEVEL:
            return level


def _render_level(state: State, module: types.ModuleType) -> tuple[str | None, bool]:
    """The level to render ``module``'s units with, and whether it is newly drawn.

    A renderer before the shared level (render API 1) takes none. A record from before it
    gets a fresh draw, which ``_adopt_level`` records only once the units are about to change;
    a render that fails first leaves nothing behind, and the next attempt draws again.
    """
    if module.RENDER_API < 2:
        return state.label_level, False
    if state.label_level is not None:
        return state.label_level, False
    return new_label_level(), True


def _adopt_level(state: State, level: str, volumes: Sequence[str]) -> None:
    """Take a newly drawn level (the caller saves the record). The files in ``volumes``
    (those recorded before it) carry each container's old, random level, which the shared one
    cannot read: each is marked for relabelling, which ``_migrate_levels`` does before any
    container runs at the new level."""
    state.label_level = level
    state.level_migration = dict.fromkeys(volumes, False) if volumes else None


def _migration_pending(state: State) -> list[str]:
    """The recorded volumes whose content is not relabelled to the shared level yet."""
    return [name for name, done in (state.level_migration or {}).items() if not done]


def _volume_storage(host: Host) -> str:
    """Where Podman keeps this user's named volumes (``podman info``: store.volumePath)."""
    info = _json_output(host, [*PODMAN, "info", "--format", "json"], "podman info")
    store = info.get("store") if isinstance(info, dict) else None
    path = store.get("volumePath") if isinstance(store, dict) else None
    if not isinstance(path, str) or not os.path.isabs(path) or os.path.normpath(path) != path:
        raise InstallError("podman info names no absolute volume storage path; no volume was "
                           "relabelled")
    return path


def _relabel_volume(host: Host, state: State, name: str, level: str, storage: str) -> None:
    """Relabel one recorded volume's content to ``level``, never following a link.

    Only a volume that exists and carries this install's label is touched, and only at the
    mount point Podman keeps it in, inside its volume storage. A bind of an operator
    directory (the derivatives directory) stays at s0, which every level reads.
    """
    labels = _object_labels(host, "volume", name)
    if labels is None:
        return  # Quadlet creates it afresh, at s0
    if labels.get(INSTALL_LABEL) != state.install_token:
        print(f"aegis-podman: warning: the volume {name} does not carry this install's label; "
              "it was left as it is", file=host.err)
        return
    entry = _single(
        _json_output(host, [*PODMAN, "volume", "inspect", name], "podman volume inspect"),
        "Name", name, "podman volume inspect",
    )
    options = entry.get("Options") or {}
    if isinstance(options, dict) and options.get("device"):
        return
    expected = os.path.join(storage, name, "_data")
    mountpoint = entry.get("Mountpoint")
    real_storage = os.path.realpath(storage)
    if (
        not isinstance(mountpoint, str) or os.path.normpath(mountpoint) != expected
        or os.path.commonpath([os.path.realpath(expected), real_storage]) != real_storage
        or os.path.realpath(expected) == real_storage
    ):
        raise InstallError(
            f"podman reports the mount point of the volume {name} as {mountpoint!r}, not "
            f"{expected}; aegis-podman relabels nothing outside Podman's volume storage"
        )
    _check(host, [*PODMAN, "unshare", "chcon", "-R", "-h", "-l", level, expected],
           f"relabelling the volume {name}", timeout=RELABEL_TIMEOUT)


def _relabel_volumes(
    host: Host, paths: Paths, state: State, names: Sequence[str], level: str, *,
    migrated: bool, timeout: float,
) -> None:
    """Stop the recorded units, then relabel each of ``names`` to ``level`` and record it.

    Nothing runs while the files change level. Each volume is recorded as soon as it is done,
    so an interrupted run resumes with the ones left.
    """
    if not names:
        return
    if state.installed and state.units:
        units = _service_units(state)
        _run(host, [*SYSTEMCTL, "--no-block", "stop", *units], timeout=120)
        if not _await_stopped(host, units, timeout):
            raise InstallError(f"{', '.join(units)} did not stop; no volume was relabelled")
    storage = _volume_storage(host)
    for name in names:
        _relabel_volume(host, state, name, level, storage)
        if state.level_migration is not None:
            state.level_migration[name] = migrated
        save_state(paths, state)


def _migrate_levels(host: Host, paths: Paths, state: State, timeout: float) -> None:
    """Relabel the recorded volumes still at the old, random levels to the shared one."""
    if state.label_level is not None:
        _relabel_volumes(host, paths, state, _migration_pending(state), state.label_level,
                         migrated=True, timeout=timeout)


def _config_text(paths: Paths, state: State) -> str:
    derivatives = _usable_derivatives(state)
    values = {
        "AEGIS_PODMAN_RELEASE": state.release,
        "AEGIS_PODMAN_REGISTRY": state.registry,
        "AEGIS_PODMAN_PREFIX": state.prefix,
        "AEGIS_PODMAN_HTTPS_PORT": str(state.https_port),
        "AEGIS_PODMAN_NAMES": ",".join(state.names),
        "AEGIS_PODMAN_BACKEND_SUBNET": state.backend_subnet,
        "AEGIS_PODMAN_HOST_GID": str(state.host_gid),
        "AEGIS_PODMAN_READER_TYPE": state.reader_type,
        "AEGIS_PODMAN_SECRETS_DIR": str(paths.secrets),
        # A record from a release before the media processor has no media image.
        **{f"AEGIS_PODMAN_IMAGE_{role.upper()}": state.images[role]
           for role in ROLES if role in state.images},
        **({} if derivatives is None else {
            "AEGIS_PODMAN_DERIVATIVES_DIR": derivatives["path"],
        }),
        **({} if state.label_level is None else {
            "AEGIS_PODMAN_LABEL_LEVEL": state.label_level,
        }),
        # What the units carry: a release from before the setting scans hourly.
        "AEGIS_PODMAN_SCAN_INTERVAL_HOURS": str(_effective_scan_interval(state)),
    }
    lines = [
        "# Aegis on rootless Podman: non-secret configuration, written by aegis-podman.",
        "# Its record (state.json in the data directory) is authoritative; change the",
        "# deployment through aegis-podman, not by editing this file.",
        *(f"{key}={value}" for key, value in values.items()),
    ]
    return "\n".join(lines) + "\n"


def _write_config(paths: Paths, state: State) -> None:
    _publish(paths, state, paths.env_file, _config_text(paths, state).encode(), "config", 0o600)


def _record_history(state: State, release: str) -> None:
    if state.history and state.history[-1].get("release") == release:
        return
    sequence = int(state.history[-1].get("sequence", 0)) + 1 if state.history else 1
    state.history.append({"sequence": sequence, "release": release})


# -- roots: the release's aegisctl, labels, drop-ins and manifests (spec D5, D6, D11) -----------


@dataclass(frozen=True)
class RenderedRoots:
    """A generation of the manifest and gateway attestation, and the drop-ins that bind it."""

    generation: str
    drop_ins: dict[str, bytes]


def _slot_argument(value: str) -> str:
    if SLOT_ID.fullmatch(value) is None:
        raise InstallError(
            f"--slot {value!r} must be a lowercase letter, then up to 62 lowercase letters, "
            "digits or hyphens"
        )
    return value


def _source_argument(value: str) -> str:
    """A root's path as the units and Podman read it: absolute, normalized and literal."""
    if (
        not value.startswith("/") or len(value) > MAX_ROOT_SOURCE or not value.isascii()
        or not value.isprintable() or not ROOT_SOURCE_UNSAFE.isdisjoint(value)
        or posixpath.normpath(value) != value
    ):
        raise InstallError(
            f"--source {value!r} must be an absolute, normalized path of printable ASCII "
            "without whitespace, quotes, backslashes, commas, colons, '%' or '$', so that "
            "Quadlet, systemd and Podman read it literally"
        )
    return value


def _identity_argument(value: str) -> str:
    if LOCAL_IDENTITY.fullmatch(value) is None and REMOTE_IDENTITY.fullmatch(value) is None:
        raise InstallError(
            f"--identity {value!r} must be local:<device>:<inode> or remote:<host>:<path>"
        )
    return value


def _overlaps(first: str, second: str) -> bool:
    return os.path.commonpath([first, second]) in (first, second)


def _ancestors(path: str) -> set[tuple[int, int]]:
    """The device and inode of ``path`` and of every directory above it that exists."""
    found = set()
    current = path
    while True:
        with contextlib.suppress(OSError):
            info = os.stat(current)
            found.add((info.st_dev, info.st_ino))
        parent = os.path.dirname(current)
        if parent == current:
            return found
        current = parent


def _apart(real: str, info: os.stat_result, other: str | Path) -> bool:
    """Whether the directory ``real`` (``info``) and ``other`` are apart: neither contains the
    other, by path or by device and inode (which also catches a bind-mounted alias)."""
    resolved = os.path.realpath(other)
    try:
        other_info: os.stat_result | None = os.stat(resolved)
    except OSError:
        other_info = None
    return not (
        _overlaps(real, resolved) or (info.st_dev, info.st_ino) in _ancestors(resolved) or (
            other_info is not None and (other_info.st_dev, other_info.st_ino) in _ancestors(real)
        )
    )


def _check_root_source(paths: Paths, state: State, slot: str, source: str) -> str:
    """The source must already be a real directory, reached through no symbolic link, apart
    from every directory of the installer, from every other root and from the derivatives
    directory, by path and by device and inode (which also catches a bind-mounted alias).
    aegis-podman never creates or changes it. Returns its identity, local:<device>:<inode>."""
    try:
        info = os.lstat(source)
    except FileNotFoundError:
        raise InstallError(
            f"{source} does not exist; aegis-podman never creates a root, so create or mount "
            "it first"
        ) from None
    except OSError as error:
        raise InstallError(f"cannot inspect {source}: {error.strerror}") from None
    if stat.S_ISLNK(info.st_mode):
        raise InstallError(f"{source} is a symbolic link; give the directory it points to")
    if not stat.S_ISDIR(info.st_mode):
        raise InstallError(f"{source} is not a directory")
    real = os.path.realpath(source)
    if real != source:
        # aegisctl resolves the path again later; a link swapped in between would redirect it.
        raise InstallError(f"{source} is reached through a symbolic link; give its real path, "
                           f"{shlex.quote(real)}")
    for directory in (paths.data, paths.config_directory, *paths.unit_directories()):
        if not _apart(real, info, directory):
            raise InstallError(
                f"{source} overlaps aegis-podman's own directory {directory}; a root must lie "
                "outside it, and it outside the root"
            )
    for other, root in sorted(state.roots.items()):
        if other != slot and _overlaps(real, os.path.realpath(root["source"])):
            raise InstallError(f"{source} overlaps the root {other} ({root['source']})")
    # The media worker writes there: inside a root it would change originals.
    derivatives = _usable_derivatives(state)
    if derivatives is not None and not _apart(real, info, derivatives["path"]):
        raise InstallError(
            f"{source} overlaps the derivatives directory {derivatives['path']}; a root "
            "must lie outside it, and it outside the root"
        )
    return f"local:{info.st_dev}:{info.st_ino}"


def _type_problem(value: str) -> str | None:
    if SELINUX_TYPE.fullmatch(value) is None:
        return f"{value!r} is not an SELinux type name"
    if (
        value in REFUSED_SELINUX_TYPES or value.endswith(REFUSED_SELINUX_SUFFIXES)
        or value.startswith(REFUSED_SELINUX_PREFIXES)
    ):
        return f"aegis_reader is never granted read access to {value}"
    return None


def _checked_type(value: str, where: str) -> str:
    problem = _type_problem(value)
    if problem is not None:
        raise InstallError(f"{where}: {problem}")
    return value


def _selinux_type(host: Host, source: str) -> str:
    """The SELinux type of ``source`` itself, from its user:role:type:level label."""
    try:
        raw = host.getxattr(source, "security.selinux")
    except OSError as error:
        raise InstallError(
            f"cannot read the SELinux label of {source}: {error.strerror or error}"
        ) from None
    try:
        label = raw.rstrip(b"\0").decode("ascii")
    except UnicodeDecodeError:
        label = ""
    parts = label.split(":", 3)
    if not label.isprintable() or len(parts) != 4 or not all(parts):
        raise InstallError(f"{source} has an SELinux label aegis-podman cannot read: {label!r}")
    return _checked_type(parts[2], f"{source} is labelled {parts[2]}")


def _module_text(template: str, types: Iterable[str]) -> str:
    """The aegis_reader module: the template with read-only rules for each type."""
    checked = sorted({_checked_type(value, "the SELinux module") for value in types})
    rules = [rule.format(type=value) for value in checked for rule in READ_RULES]
    try:
        return _substitute(SELINUX_TEMPLATE, template, {
            "READ_RULES": "\n    ".join(rules) or "; no root type is covered yet",
        })
    except RenderError as error:
        raise InstallError(f"the SELinux module template: {error}") from None


def _inherited_templates(module: str) -> list[str]:
    """The udica template files that provide the blocks ``module`` inherits, in order."""
    code = "\n".join(line.partition(";")[0] for line in module.splitlines())
    templates: list[str] = []
    for block in re.findall(r"\(\s*blockinherit\s+([^\s()]+)\s*\)", code):
        template = UDICA_TEMPLATES.get(block)
        if template is None:
            raise InstallError(
                f"the SELinux module inherits {block}, which no udica template known to "
                "aegis-podman provides"
            )
        if template not in templates:
            templates.append(template)
    if UDICA_TEMPLATES["container"] not in templates:
        raise InstallError("the SELinux module does not inherit udica's container template")
    return templates


def _remove_probe(host: Host, name: str, token: str) -> None:
    """Remove the probe container ``name`` if it is still there: only by its exact ID, and
    only when it carries this probe's label."""
    exists = _run(host, [*PODMAN, "container", "exists", name], timeout=60)
    if exists.returncode == 1:
        return
    if exists.returncode != 0:
        raise InstallError(
            f"podman container exists {name} failed{_detail(exists.stderr)}; check for the "
            f"probe container with: podman container inspect {name}"
        )
    entry = _single(
        _json_output(host, [*PODMAN, "container", "inspect", name], "podman container inspect"),
        "Name", name, "podman container inspect",
    )
    labels = (entry.get("Config") or {}).get("Labels") or {}
    identifier = entry.get("Id")
    if (
        not isinstance(labels, dict) or labels.get(PROBE_LABEL) != token
        or not isinstance(identifier, str) or CONTAINER_ID.fullmatch(identifier) is None
    ):
        raise InstallError(
            f"a container named {name} exists without this probe's label; it was left in place"
        )
    # --ignore: Podman's own --rm cleanup may remove it first, which is just as good.
    _check(host, [*PODMAN, "rm", "--force", "--ignore", identifier],
           f"removing the probe container {name}", timeout=120)


def _probe_file(host: Host, source: str, selinux_type: str) -> str | None:
    """A regular file at the top of ``source`` for the probe to open, or None.

    It has the root's own SELinux type: a file of another type, as ``mv`` leaves one, must
    not fail the probe. The permission bits that apply to the probe's user must allow
    reading: the group's when the file is in the operator's group, which the probe has as
    its mapped group, and the others' bits otherwise. Only metadata is read, from at most
    ``PROBE_CANDIDATES`` entries.
    """
    try:
        entries = os.scandir(source)
    except OSError:
        return None
    with entries:
        for index, entry in enumerate(entries):
            if index >= PROBE_CANDIDATES:
                break
            try:
                info = entry.stat(follow_symlinks=False)
            except OSError:
                continue
            bits = stat.S_IRGRP if info.st_gid == host.gid else stat.S_IROTH
            if not stat.S_ISREG(info.st_mode) or not info.st_mode & bits:
                continue
            try:
                label = host.getxattr(entry.path, "security.selinux")
            except OSError:
                continue
            parts = label.rstrip(b"\0").decode("ascii", "replace").split(":", 3)
            if len(parts) == 4 and parts[2] == selinux_type:
                return entry.name
    return None


def _probe_reader(
    host: Host, state: State, source: str, selinux_type: str,
) -> tuple[bool, str]:
    """Whether the loaded policy lets the reader type read ``source``, and why not.

    This is the unprivileged proof that the host setup loaded a module granting the root's
    type; ``semodule -l`` needs root. A container of the backend image, running as the reader
    type under the deployment's group mapping, lists the root directory and opens one of its
    top-level files of the root's type, if it has one (``_probe_file``), through a read-only
    bind with no relabel option. Only reading proves it: the reader type exists as soon as
    any earlier module was loaded, and other policy may already allow listing a directory.
    The container runs with --rm; one that a timed-out run leaves behind is removed by exact
    name, label and ID.
    """
    file = _probe_file(host, source, selinux_type)
    name = f"aegis-probe-{secrets.token_hex(8)}"
    token = secrets.token_hex(16)
    command = [
        *PODMAN, "run", "--rm", "--pull", "never", "--network", "none", "--name", name,
        "--label", f"{PROBE_LABEL}={token}", "--security-opt", f"label=type:{state.reader_type}",
        "--read-only", "--cap-drop", "all", "--security-opt", "no-new-privileges",
        "--user", BACKEND_USER, "--gidmap", f"+g{BACKEND_GID}:@{state.host_gid}:1",
        "-v", f"{source}:{PROBE_TARGET}:ro", "--entrypoint", "/bin/sh", state.images["backend"],
        "-c", PROBE_SCRIPT, "aegis-probe", *([] if file is None else [file]),
    ]
    try:
        result = host.run(command, timeout=PROBE_TIMEOUT)
    except FileNotFoundError:
        raise InstallError("podman is not installed") from None
    except subprocess.TimeoutExpired:
        _remove_probe(host, name, token)
        raise InstallError(
            f"the SELinux reader probe did not finish within {PROBE_TIMEOUT:g}s; nothing of it "
            "is left, so try again"
        ) from None
    if result.returncode == 0:
        return True, ""
    _remove_probe(host, name, token)  # --rm leaves nothing behind; make sure of it
    return False, _detail(result.stderr)


def _write_module(host: Host, paths: Paths, state: State) -> str:
    """Write the module for the covered and pending types, from the current release's
    template. Only the host-setup script, run by the operator, loads it."""
    _extract_release(host, paths, state, state.release, state.images["backend"])
    raw = _verified_tree(paths, state, state.release).get(SELINUX_TEMPLATE)
    if raw is None:
        raise InstallError(
            f"release {state.release} ships no SELinux module template ({SELINUX_TEMPLATE}); "
            "move to a release that does"
        )
    try:
        template = raw.decode("utf-8")
    except UnicodeDecodeError:
        raise InstallError("the SELinux module template is not UTF-8") from None
    text = _module_text(template, [*state.selinux_covered, *state.selinux_pending])
    _inherited_templates(text)
    _check_replaceable(state, paths.selinux_module)
    _publish(paths, state, paths.selinux_module, text.encode("utf-8"), "selinux", 0o644)
    return text


def _library_records(state: State, release: str) -> list[str]:
    return [
        path for path, record in state.files.items()
        if record.get("kind") == "lib" and record.get("release") == release
    ]


def _release_library(
    host: Host, paths: Paths, state: State, release: str, backend_image: str,
) -> Path:
    """``releases/<release>/lib``: that release's aegisctl, copied out of its backend image
    by digest, recorded file by file and verified before every use."""
    _extract_release(host, paths, state, release, backend_image)
    library = paths.library(release)
    recorded = _library_records(state, release)
    if recorded and os.path.lexists(library):
        expected = {
            posixpath.relpath(path, str(library)): state.files[path].get("sha256")
            for path in recorded
        }
        contents = _walk_tree(library, normalize=False, what="the aegisctl copy")
        actual = {name: hashlib.sha256(content).hexdigest() for name, content in contents.items()}
        if actual != expected:
            raise InstallError(
                f"the aegisctl copy {library} differs from its record; refusing to run it"
            )
        return library
    for path in recorded:  # lost: copy it out again
        del state.files[path]
    if os.path.lexists(library):
        raise InstallError(f"{library} exists but is not recorded by aegis-podman; move it")
    staging = paths.releases / f".{release}.lib.{secrets.token_hex(8)}.partial"
    staging.mkdir(mode=0o700)
    try:
        _copy_out(host, paths, state, backend_image, staging / LIBRARY_PACKAGE, LIBRARY_SOURCE)
        _drop_bytecode(staging)
        contents = _walk_tree(staging, normalize=True, what="the aegisctl copy")
        missing = [name for name in LIBRARY_REQUIRED if name not in contents]
        if missing:
            raise InstallError(f"the backend image's aegisctl lacks {', '.join(missing)}")
        for relative, content in contents.items():
            state.files[str(library / relative)] = {
                "kind": "lib", "release": release,
                "sha256": hashlib.sha256(content).hexdigest(),
            }
        save_state(paths, state)
        os.rename(staging, library)
    except BaseException:
        _remove_tree(staging)
        raise
    _sync_directory(library.parent)
    return library


def _aegisctl_error(stderr: str | None) -> str:
    lines = [line for line in (stderr or "").splitlines() if line.strip()]
    if lines:
        try:
            payload = json.loads(lines[-1])
        except json.JSONDecodeError:
            payload = None
        if isinstance(payload, dict) and isinstance(payload.get("message"), str):
            return f": {payload['message'][:512]}"
    return _detail(stderr)


def _aegisctl(
    host: Host, library: Path, verb: str, *arguments: str, timeout: float = 120,
) -> str:
    """Run ``aegisctl mounts <verb>`` from the release's copy on the host's Python."""
    environment = {
        key: value for key, value in host.environ.items() if not key.startswith("PYTHON")
    }
    environment |= {"PYTHONPATH": str(library), "AEGIS_CONTAINER_ENGINE": "podman"}
    result = _run(
        host,
        [host.python, *AEGISCTL_FLAGS, "-m", LIBRARY_PACKAGE, "mounts", verb, *arguments],
        timeout=timeout, env=environment,
    )
    if result.returncode != 0:
        raise InstallError(
            f"aegisctl mounts {verb} refused (exit {result.returncode})"
            f"{_aegisctl_error(result.stderr)}"
        )
    return result.stdout


def _mounts_config(roots: Mapping[str, Mapping[str, str]]) -> bytes:
    """aegisctl's mount configuration for ``roots``: every root read-only."""
    lines = [
        "# aegisctl's mount configuration, written by aegis-podman from its record. Change",
        "# the roots with aegis-podman roots add and remove, not in this file.",
        "version = 1",
    ]
    for slot, root in sorted(roots.items()):
        lines += [
            "", "[[slots]]", f"slot_id = {json.dumps(slot)}",
            f"source = {json.dumps(root['source'])}",
            f"container_path = {json.dumps(f'/srv/aegis/roots/{slot}')}",
            'mode = "read_only"', f"expected_identity = {json.dumps(root['identity'])}",
        ]
    return ("\n".join(lines) + "\n").encode("ascii")


def _check_drop_ins(paths: Paths, state: State) -> None:
    for role in ROOT_ROLES:
        _check_replaceable(state, paths.drop_in(state.prefix, role))


def _drop_in_paths(state: State) -> list[Path]:
    return [Path(path) for path, record in state.files.items() if record.get("kind") == "drop-in"]


def _drop_in_problem(
    role: str, sections: Mapping[str, list[tuple[str, str]]],
    roots: Mapping[str, Mapping[str, str]], manifest: str, attestation: str,
) -> str | None:
    """What a rendered drop-in sets beyond exactly what aegisctl's render gives ``role``.

    Readers bind every root read-only at its slot path with no other option (a relabel or
    chown option on an original is what the spec forbids most), and every role but the media
    processor binds the manifest, or for the gateway the attestation, under its fixed
    variables. The processor binds the roots alone. Only the three workers replace their
    command, with the attestation step.
    """
    entries = sections.get("Container", [])
    if set(sections) != {"Container"} or not {key for key, _ in entries} <= DROP_IN_KEYS:
        return "sets more than Environment, Exec and Volume"
    names = sorted(value.partition("=")[0] for key, value in entries if key == "Environment")
    gateway = role == "gateway"
    processor = role == PROCESSOR_ROLE
    variables = set() if processor else ATTESTATION_VARIABLES if gateway else MANIFEST_VARIABLES
    if names != sorted(variables):
        return f"sets the environment variables {', '.join(names) or 'none'}"
    if len(_values(sections, "Container", "Exec")) != (1 if role in WORKER_ROLES else 0):
        return "replaces the command of a role other than the workers"
    expected = set() if processor else {
        f"{attestation}:{ATTESTATION_TARGET}:ro" if gateway
        else f"{manifest}:{MANIFEST_TARGET}:ro"
    }
    if gateway or processor or role in WORKER_ROLES:
        expected |= {
            f"{os.path.realpath(root['source'])}:/srv/aegis/roots/{slot}:ro"
            for slot, root in roots.items()
        }
    volumes = _values(sections, "Container", "Volume")
    if len(volumes) != len(set(volumes)) or set(volumes) != expected:
        return ("binds other than its roots, read-only and without options, and its manifest "
                "or attestation")
    return None


def _root_roles(prefix: str, services: Iterable[str]) -> tuple[str, ...]:
    """The roles of ``ROOT_ROLES`` whose units are among ``services`` (``<prefix><role>.service``,
    a unit inventory's container services): the drop-ins that release's aegisctl renders."""
    present = set(services)
    return tuple(role for role in ROOT_ROLES if f"{prefix}{role}.service" in present)


def _read_drop_ins(
    directory: Path, prefix: str, roots: Mapping[str, Mapping[str, str]], manifest: Path,
    attestation: Path, roles: Sequence[str],
) -> dict[str, bytes]:
    """The drop-ins aegisctl rendered into ``directory``, one for each of ``roles``, checked
    before any is used."""
    expected = {f"{prefix}{role}.container.d/{DROP_IN}": role for role in roles}
    contents = _walk_tree(directory, normalize=False, what="aegisctl's rendered drop-ins")
    if set(contents) != set(expected):
        raise InstallError(
            f"aegisctl rendered other drop-ins than the {len(expected)} expected: "
            f"{', '.join(sorted(contents)) or 'none'}"
        )
    drop_ins = {}
    for relative, content in contents.items():
        try:
            sections = _unit_sections(content.decode("ascii"))
        except UnicodeDecodeError:
            raise InstallError(f"the rendered drop-in {relative} is not ASCII") from None
        problem = _drop_in_problem(
            expected[relative], sections, roots, os.path.realpath(manifest),
            os.path.realpath(attestation),
        )
        if problem is not None:
            raise InstallError(f"the rendered drop-in {relative} {problem}; refusing it")
        drop_ins[expected[relative]] = content
    return drop_ins


def _render_roots(
    host: Host, paths: Paths, state: State, roots: Mapping[str, Mapping[str, str]],
    release: str, images: Mapping[str, str], *, roles: Sequence[str],
    local_images: bool | None = None,
) -> RenderedRoots:
    """Validate, observe and render ``roots`` with ``release``'s aegisctl.

    The result is a new generation of the manifest and gateway attestation, with the
    drop-ins that bind it; nothing installed changes, so the drop-ins in place keep binding
    their own generation until ``_install_drop_ins`` replaces them. The manifest is rendered
    right after a fresh preflight, while the operator still owns it, and only then handed to
    the group-mapped container user (spec D5). Both files are labelled container_file_t;
    the originals themselves are never touched. ``roles`` are the root roles whose units
    ``release`` renders (``_root_roles``), so exactly their drop-ins are expected.
    ``local_images`` (default: the record's) says that ``images`` are the deployment test's
    local image IDs.
    """
    test_images = state.local_images if local_images is None else local_images
    for slot, root in sorted(roots.items()):
        selinux_type = _selinux_type(host, root["source"])
        if selinux_type not in state.selinux_covered:
            source = shlex.quote(root["source"])
            advice = (
                f"add it again with: aegis-podman roots add --slot {slot} --source {source}"
                if state.installed else
                f"remove it with: aegis-podman roots remove --slot {slot}, install, then add "
                "it again"
            )
            raise InstallError(
                f"the root {slot} ({root['source']}) is labelled {selinux_type}, which the "
                f"loaded aegis_reader module does not cover; {advice}"
            )
    _check_drop_ins(paths, state)
    _check_replaceable(state, paths.mounts_config)
    library = _release_library(host, paths, state, release, images["backend"])
    _publish(paths, state, paths.mounts_config, _mounts_config(roots), "mounts-config", 0o600)
    generation = secrets.token_hex(8)
    manifest, attestation = paths.manifest(generation), paths.attestation(generation)
    if os.path.lexists(manifest) or os.path.lexists(attestation):
        raise InstallError(f"{manifest} or {attestation} already exists; refusing to reuse it")
    state.mounts["generations"][generation] = {"manifest": None, "attestation": None}
    save_state(paths, state)
    config, gid = str(paths.mounts_config), str(state.host_gid)
    _aegisctl(host, library, "validate", "--config", config)
    _aegisctl(
        host, library, "preflight", "--config", config, "--manifest", str(manifest),
        "--observer", "podman-run", "--observer-image", images["gateway"], "--host-gid", gid,
        "--reader-type", state.reader_type, *(["--allow-test-image-id"] if test_images else []),
        timeout=300,
    )
    staging = paths.mounts / f".render.{secrets.token_hex(8)}.partial"
    staging.mkdir(mode=0o700)
    try:
        _aegisctl(
            host, library, "render", "--format", "quadlet", "--config", config,
            "--manifest", str(manifest), "--gateway-attestation", str(attestation),
            "--unit-prefix", state.prefix, "--output-dir", str(staging), "--host-gid", gid,
        )
        drop_ins = _read_drop_ins(staging, state.prefix, roots, manifest, attestation, roles)
    finally:
        _remove_tree(staging)
    prepare_for_mapped_containers(host, manifest)
    _check(host, [*CONTAINER_FILE_LABEL, str(attestation)],
           f"labelling {attestation}", timeout=60)
    info = manifest.lstat()
    state.mounts["generations"][generation] = {
        # The operator can no longer read it: its identity, as for the secrets.
        "manifest": {"device": info.st_dev, "inode": info.st_ino, "ctime_ns": info.st_ctime_ns},
        "attestation": _file_digest(attestation),
    }
    save_state(paths, state)
    return RenderedRoots(generation, drop_ins)


def _own_directory(directory: Path) -> None:
    with contextlib.suppress(FileExistsError):
        directory.mkdir(mode=0o700)
    if not stat.S_ISDIR(directory.lstat().st_mode):
        raise InstallError(f"{directory} is not a directory; refusing to write into it")


def _install_drop_ins(paths: Paths, state: State, rendered: RenderedRoots) -> set[str]:
    """Write the drop-ins as recorded files; return the roles whose drop-in changed.

    The generation is recorded as ``installing`` before the first drop-in is written. Until
    ``_commit_roots`` runs, after systemd has loaded them all, the drop-ins may bind two
    generations: the switch is flagged, the next install or roots command renders again,
    and pruning keeps both. A recorded drop-in of a role the rendered release has no unit
    for (going back to a release before the media processor) is removed with that unit.
    """
    _check_drop_ins(paths, state)
    stale = []
    for role in ROOT_ROLES:
        path = paths.drop_in(state.prefix, role)
        if role not in rendered.drop_ins and str(path) in state.files:
            _check_removable(paths, state, path, force=False)
            stale.append(path)
    # An interrupted switch may have written drop-ins that no restart applied: the rerun
    # finds the processor's, which binds the roots alone and names no generation, already
    # in place. Every rendered role counts as changed then, so each unit restarts.
    interrupted = state.mounts["installing"] is not None
    state.mounts["installing"] = rendered.generation
    save_state(paths, state)
    changed = set()
    for role in ROOT_ROLES:
        if role not in rendered.drop_ins:
            continue
        path = paths.drop_in(state.prefix, role)
        _own_directory(path.parent)
        if _publish(paths, state, path, rendered.drop_ins[role], "drop-in", 0o644) or (
            interrupted
        ):
            changed.add(role)
    _remove_drop_ins(paths, state, stale)
    state.mounts["current"] = rendered.generation
    save_state(paths, state)
    return changed


def _remove_drop_ins(paths: Paths, state: State, drop_ins: Sequence[Path]) -> None:
    for path in drop_ins:
        _remove_recorded(paths, state, path)
        with contextlib.suppress(OSError):  # the drop-in directory, once it is empty
            path.parent.rmdir()


def _roots_need_render(
    paths: Paths, state: State, roles: Sequence[str] | None = None,
) -> bool:
    """Whether the roots' drop-ins, or the files they bind, are not all in place as recorded:
    a switch was interrupted, a drop-in is missing, unsettled, changed or binds another
    generation, or the current generation's files are gone. ``roles`` (default: those of the
    installed units) are the roles that must each have one."""
    current = state.mounts["current"]
    if state.mounts["installing"] is not None or current is None:
        return True
    if roles is None:
        roles = _root_roles(state.prefix, state.units.get("containers", {}))
    expected = {role: paths.drop_in(state.prefix, role) for role in roles}
    if {str(path) for path in _drop_in_paths(state)} != {str(path) for path in expected.values()}:
        return True
    manifest, attestation = paths.manifest(current), paths.attestation(current)
    if not (os.path.lexists(manifest) and os.path.lexists(attestation)):
        return True
    for role, path in expected.items():
        record = state.files[str(path)]
        try:
            content = _read_regular(path)
        except (OSError, InstallError):
            return True
        if "previous" in record or hashlib.sha256(content).hexdigest() != record["sha256"]:
            return True
        # The processor's binds the roots alone, so no generation file shows in it.
        bound = os.path.realpath(attestation if role == "gateway" else manifest)
        if role != PROCESSOR_ROLE and f"\nVolume={bound}:".encode() not in content:
            return True
    return False


def _generation_files(
    paths: Paths, generation: str, record: Mapping[str, Any], *, force: bool,
) -> tuple[list[Path], list[str]]:
    """A generation's files that may go, and the problems that keep the others."""
    removable: list[Path] = []
    problems: list[str] = []
    manifest = paths.manifest(generation)
    info = _lstat(manifest)
    if info is not None:
        identity = record.get("manifest")
        if force or (stat.S_ISREG(info.st_mode) and (identity is None
                                                     or _same_file(info, identity))):
            removable.append(manifest)
        else:
            problems.append(f"{manifest} is not the manifest aegis-podman prepared")
    attestation = paths.attestation(generation)
    info = _lstat(attestation)
    if info is not None:
        expected = record.get("attestation")
        if force or (stat.S_ISREG(info.st_mode) and (expected is None
                                                     or _file_digest(attestation) == expected)):
            removable.append(attestation)
        else:
            problems.append(f"{attestation} was changed since aegisctl rendered it")
    return removable, problems


def _bound_paths(state: State) -> set[str]:
    """Every file a recorded drop-in on disk binds, as a resolved path."""
    bound = set()
    for path in _drop_in_paths(state):
        try:
            content = _read_regular(path).decode("ascii", "replace")
        except (OSError, InstallError):
            continue
        for line in content.splitlines():
            key, _, value = line.partition("=")
            if key.strip() == "Volume":
                bound.add(os.path.realpath(value.split(":")[0]))
    return bound


def _prune_generations(host: Host, paths: Paths, state: State) -> None:
    """Remove the generations nothing binds any more: not the current one, not one being
    installed, and none whose manifest or attestation a drop-in on disk binds. A file that
    is not what aegis-podman wrote stays, with its generation recorded, and a warning says
    so."""
    bound = _bound_paths(state)
    for generation, record in list(state.mounts["generations"].items()):
        if generation in (state.mounts["current"], state.mounts["installing"]) or any(
            os.path.realpath(path) in bound
            for path in (paths.manifest(generation), paths.attestation(generation))
        ):
            continue
        removable, problems = _generation_files(paths, generation, record, force=False)
        if problems:
            print(f"aegis-podman: warning: kept {'; '.join(problems)}", file=host.err)
            continue
        for path in removable:
            with contextlib.suppress(FileNotFoundError):
                os.unlink(path)
        del state.mounts["generations"][generation]
        save_state(paths, state)


def _leftover_drop_ins(paths: Paths, state: State) -> bool:
    """Whether drop-ins are recorded, or a switch is marked, while no root is: an interrupted
    first ``roots add``. They are checked here and removed, before the next reload, by
    ``_remove_roots``, because no slot means nothing to render."""
    drop_ins = _drop_in_paths(state)
    if state.roots or not (drop_ins or state.mounts["installing"] is not None):
        return False
    for path in drop_ins:
        _check_removable(paths, state, path, force=False)
    return True


def _remove_roots(paths: Paths, state: State) -> set[str]:
    """The last root goes, and with no slot there is nothing to render: remove every drop-in.

    The manifests and attestations stay until systemd has loaded the units without them;
    ``_commit_roots`` prunes them then, with aegisctl's configuration. Returns every root
    role: a rerun after a failed reload has no drop-in left to remove, yet the units still
    need their restart.
    """
    drop_ins = _drop_in_paths(state)
    for path in drop_ins:
        _check_removable(paths, state, path, force=False)
    _remove_drop_ins(paths, state, drop_ins)
    state.mounts["current"] = None
    state.mounts["installing"] = None
    save_state(paths, state)
    return set(ROOT_ROLES)


def _restart_roots(host: Host, state: State, changed: set[str]) -> bool:
    """Queue a restart of the units whose drop-ins changed, when Aegis should run."""
    if state.desired != "running":
        return False
    known = {*state.units["services"], *state.units["oneshots"]}
    units = [
        unit for role in ROOT_ROLES
        if role in changed and (unit := f"{state.prefix}{role}.service") in known
    ]
    if not units:
        return False
    _check(host, [*SYSTEMCTL, "--no-block", "restart", *units], "systemctl --user restart",
           timeout=120)
    return True


def _commit_roots(
    host: Host, paths: Paths, state: State, roots: Mapping[str, Mapping[str, str]],
    forget_types: Iterable[str] = (),
) -> None:
    """systemd has loaded the drop-ins for ``roots``, and any restart is queued: record them,
    end the switch, and remove what nothing binds any more. A type in ``forget_types`` that
    no root uses is no longer covered, so the next host setup loads a module without it."""
    state.roots = {slot: dict(root) for slot, root in roots.items()}
    used = {root["selinux_type"] for root in roots.values()}
    unused = set(forget_types) - used
    state.selinux_covered = [value for value in state.selinux_covered if value not in unused]
    _settle(paths, state)
    # The switch ends only once pruning, which keeps the generation being installed, is done.
    _prune_generations(host, paths, state)
    state.mounts["installing"] = None
    save_state(paths, state)
    if not roots and str(paths.mounts_config) in state.files:
        try:
            _check_removable(paths, state, paths.mounts_config, force=False)
            _remove_recorded(paths, state, paths.mounts_config)
        except InstallError as error:
            print(f"aegis-podman: warning: kept {paths.mounts_config}: {error}", file=host.err)


def _apply_roots(
    host: Host, paths: Paths, state: State, changed: set[str],
    roots: Mapping[str, Mapping[str, str]], *, rerun: str, forget_types: Iterable[str] = (),
) -> bool:
    """Reload systemd and queue any restart; only then commit ``roots`` and prune.

    A failure on the way keeps the record and every file systemd may still bind, so running
    the same command again finishes the job.
    """
    try:
        _check(host, [*SYSTEMCTL, "daemon-reload"], "systemctl --user daemon-reload",
               timeout=120)
        restart = _restart_roots(host, state, changed)
    except InstallError as error:
        raise InstallError(f"{error}; nothing was committed, so finish with: {rerun}") from None
    _commit_roots(host, paths, state, roots, forget_types)
    return restart


def _after_roots(
    host: Host, state: State, args: argparse.Namespace, restart: bool, changed: set[str],
) -> int:
    if restart:
        _say(host, "Restarting the units whose drop-ins changed")
        if not _await_ready(host, state, args.timeout):
            return 1
        _say(host, "aegis-podman: every unit is active, healthy and on its recorded image")
    elif not changed:
        _say(host, "No drop-in changed")
    else:
        _say(host, "Aegis is stopped; the roots apply at the next aegis-podman start")
    return 0


def _command_words(args: argparse.Namespace) -> str:
    """The options that select this install, for the commands a message suggests."""
    words = [] if args.prefix is None else ["--prefix", args.prefix]
    words += [] if args.state_home is None else ["--state-home", args.state_home]
    return "".join(f" {shlex.quote(word)}" for word in words)


def _report_pending(
    host: Host, paths: Paths, state: State, args: argparse.Namespace, slot: str, source: str,
    selinux_type: str, probe: str | None,
) -> None:
    zones = " ".join(f"--zone {zone}" for zone in state.firewall_zones) or "--zone <zone>"
    rerun = (f"aegis-podman roots add{_command_words(args)} --slot {slot} "
             f"--source {shlex.quote(source)}")
    if args.identity is not None:
        rerun += f" --identity {shlex.quote(args.identity)}"
    if probe is None:
        _say(host, f"aegis-podman: {source} is labelled {selinux_type}, which the loaded "
                   "aegis_reader SELinux module does not cover yet.")
    else:
        _say(host, f"aegis-podman: the reader probe could not read {source} as "
                   f"{state.reader_type}{probe}. Either the host setup has not loaded the "
                   f"module that covers {selinux_type} yet, or the directory is not readable "
                   "by its group.")
    _say(host, f"  The module file covers it: {paths.selinux_module}")
    _say(host, "  Review it, then write and review the host setup script, and run it with sudo:")
    _say(host, f"    aegis-podman host-setup{_command_words(args)} {zones}")
    _say(host, f"    sudo sh {paths.host_setup}")
    _say(host, "  Then add the root again; a probe checks that the module is loaded:")
    _say(host, f"    {rerun}")


def command_roots(host: Host, paths: Paths, args: argparse.Namespace) -> int:
    if args.roots_command == "add":
        return _roots_add(host, paths, args)
    return _roots_remove(host, paths, args)


def _roots_add(host: Host, paths: Paths, args: argparse.Namespace) -> int:
    """Add a read-only root (spec D11).

    In order: the source is checked and its SELinux type read. A type no probe has proven
    loaded is probed; when the reader type cannot read the root, the type is added to the
    module file and the command stops (exit 4) for the operator's host setup. Only then is
    the release's aegisctl copied
    out and run (inspect, validate, preflight, render), the manifest prepared, the drop-ins
    installed and systemd reloaded; a running stack restarts the units whose drop-ins changed.
    """
    slot = _slot_argument(args.slot)
    source = _source_argument(args.source)
    identity = None if args.identity is None else _identity_argument(args.identity)
    _check_directories(paths, host.uid, create=False)
    with _locked(paths):
        state = _installed_state(paths, host.uid, args)
        _refuse_pending(state)
        _check_directories(paths, host.uid, create=True)
        observed = _check_root_source(paths, state, slot, source)
        recorded = state.roots.get(slot)
        if recorded is not None:
            if recorded["source"] != source:
                raise InstallError(
                    f"the slot {slot} already uses {recorded['source']}; remove it first with: "
                    f"aegis-podman roots remove --slot {slot}"
                )
            if identity is not None and identity != recorded["identity"]:
                raise InstallError(
                    f"the slot {slot} expects the identity {recorded['identity']}, not {identity}"
                )
            identity = recorded["identity"]  # the same root again: render it afresh
        if identity is not None and identity.startswith("local:") and identity != observed:
            raise InstallError(
                f"{source} has the identity {observed}, not {identity}; is it the right "
                "directory, with its file system mounted?"
            )
        selinux_type = _selinux_type(host, source)
        if state.reader_type == TEST_READER_TYPE:
            # A deployment-test stack loads no module: its plain container_t readers read
            # container_file_t, so there is nothing to probe or regenerate.
            if selinux_type != CONTAINER_FILE_TYPE:
                raise InstallError(
                    f"{source} is labelled {selinux_type}, but this stack's readers run as "
                    f"{TEST_READER_TYPE} with no module, which reads only {CONTAINER_FILE_TYPE} "
                    "roots"
                )
            if selinux_type not in state.selinux_covered:
                state.selinux_covered = sorted({*state.selinux_covered, selinux_type})
                save_state(paths, state)
        was_pending = selinux_type in state.selinux_pending
        probe = None
        if selinux_type not in state.selinux_covered:
            # The loaded module may grant it already: it is pending, or a removal forgot it
            # while the module that grants it is still loaded.
            readable, probe = _probe_reader(host, state, source, selinux_type)
            if readable:
                # Proven for this type only: an older module may grant one pending type and
                # not another.
                if was_pending:
                    state.selinux_pending.remove(selinux_type)
                state.selinux_covered = sorted({*state.selinux_covered, selinux_type})
                save_state(paths, state)
        if selinux_type not in state.selinux_covered:
            if selinux_type not in state.selinux_pending:
                state.selinux_pending.append(selinux_type)
            _write_module(host, paths, state)
            _settle(paths, state)
            _report_pending(host, paths, state, args, slot, source, selinux_type,
                            probe if was_pending else None)
            return EXIT_MODULE_PENDING
        _preflight(host, paths)
        library = _release_library(host, paths, state, state.release, state.images["backend"])
        inspected = _aegisctl(host, library, "inspect", "--source", source).strip()
        if inspected != observed:
            raise InstallError(
                f"{source} changed while it was being added: aegisctl sees "
                f"{inspected or 'nothing'}, not {observed}; check it and try again"
            )
        roots = {**state.roots, slot: {
            "source": source, "identity": identity or observed, "selinux_type": selinux_type,
        }}
        rendered = _render_roots(
            host, paths, state, roots, state.release, state.images,
            roles=_root_roles(state.prefix, state.units["containers"]),
        )
        changed = _install_drop_ins(paths, state, rendered)
        restart = _apply_roots(
            host, paths, state, changed, roots, rerun=f"aegis-podman roots add"
            f"{_command_words(args)} --slot {slot} --source {shlex.quote(source)}",
        )
    _say(host, f"aegis-podman: the root {slot} ({source}, {selinux_type}) is configured")
    return _after_roots(host, state, args, restart, changed)


def _roots_remove(host: Host, paths: Paths, args: argparse.Namespace) -> int:
    """Remove a root: render the others again, or, for the last one, remove its files.

    With the units uninstalled there are no drop-ins, so only the record changes and install
    renders the roots left. That way a root that can no longer be observed never blocks
    install.
    """
    slot = _slot_argument(args.slot)
    _check_directories(paths, host.uid, create=False)
    with _locked(paths):
        state = _ready_state(paths, host.uid, args)
        _refuse_pending(state)
        if slot not in state.roots:
            raise InstallError(f"no root uses the slot {slot}")
        remaining = {name: root for name, root in state.roots.items() if name != slot}
        forget = [state.roots[slot]["selinux_type"]]
        if not state.installed:
            if not remaining:
                _remove_roots(paths, state)
            _commit_roots(host, paths, state, remaining, forget)
            _say(host, f"aegis-podman: removed the root {slot} from the record; the units are "
                       "not installed, so aegis-podman install renders the roots left")
            return 0
        _preflight(host, paths)
        # The slot stays recorded until systemd has the units without it and their restart
        # is queued, so a failure on the way leaves a command that can simply be run again.
        if remaining:
            rendered = _render_roots(
                host, paths, state, remaining, state.release, state.images,
                roles=_root_roles(state.prefix, state.units["containers"]),
            )
            changed = _install_drop_ins(paths, state, rendered)
        else:
            changed = _remove_roots(paths, state)
        restart = _apply_roots(
            host, paths, state, changed, remaining, forget_types=forget,
            rerun=f"aegis-podman roots remove{_command_words(args)} --slot {slot}",
        )
    _say(host, f"aegis-podman: removed the root {slot}" + (
        "" if remaining else "; no root is left, so the drop-ins, manifest and attestation "
                             "are removed"))
    return _after_roots(host, state, args, restart, changed)


# -- the host-setup script (spec D6, D7) -------------------------------------------------------


def _zone_argument(value: str) -> str:
    if ZONE.fullmatch(value) is None:
        raise InstallError(
            f"--zone {value!r} must be a firewalld zone name of 1 to 32 letters, digits, "
            "underscores or hyphens"
        )
    return value


def _operator_login(host: Host) -> str:
    try:
        name = host.login_name(host.uid)
    except KeyError:
        raise InstallError(
            f"uid {host.uid} has no account name, which the host setup script needs"
        ) from None
    if not isinstance(name, str) or LOGIN.fullmatch(name) is None:
        raise InstallError(
            f"the account name {name!r} cannot be embedded in the host setup script safely"
        )
    return name


def _rich_rules(zones: Sequence[str], port: int) -> list[tuple[str, str]]:
    """Each zone's rich rules: the HTTPS port from each private or VPN source range."""
    return [
        (zone, f"rule family={family} source address={source} port port={port} protocol=tcp "
               "accept")
        for zone in zones for family, source in PRIVATE_SOURCES
    ]


def _host_setup_script(
    paths: Paths, login: str, templates: Sequence[str], zones: Sequence[str], port: int,
    module_digest: str,
) -> str:
    """The script the operator reviews and runs with sudo (spec D7).

    It loads the module with exactly the udica templates it inherits, and admits the HTTPS
    port from the private and VPN ranges in each zone by one rich rule each, added to the
    permanent and to the runtime configuration only where a query finds it missing. It never
    reloads firewalld, which would drop the runtime-only rules of other services, never
    changes a zone's target, adds a service or a port without a source, or removes anything.
    It loads the module only if its content is still the one this script was written for,
    and it warns, changing nothing, when a zone already admits the port from everywhere.
    """
    quote = shlex.quote
    lines = [
        "#!/bin/sh",
        "# Aegis host setup, written by aegis-podman host-setup (spec D6, D7). Review it, then",
        f"# run it once with: sudo sh {quote(str(paths.host_setup))}",
        "#",
        "# It installs udica if it is missing, loads the aegis_reader SELinux module with the",
        f"# udica templates it inherits, and admits TCP port {port} only from private and VPN",
        "# source ranges in the named firewalld zones, in the permanent and the runtime",
        "# configuration, adding each rule only where it is missing. It never reloads firewalld",
        "# (that would drop other services' runtime-only rules), changes no zone's target, opens",
        "# no other port or service, and removes nothing.",
        "set -eu",
        "",
        'if [ "$(id -u)" -ne 0 ]; then',
        '    echo "aegis host setup: run this script with sudo" >&2',
        "    exit 1",
        "fi",
        f'if [ "${{SUDO_USER:-}}" != {quote(login)} ]; then',
        f"    echo {quote(f'aegis host setup: run it with sudo from the account {login}')} >&2",
        "    exit 1",
        "fi",
        "",
        f"if ! printf '%s  %s\\n' {module_digest} {quote(str(paths.selinux_module))} "
        "| sha256sum --check --status -; then",
        "    echo " + quote(
            f"aegis host setup: {paths.selinux_module} changed since this script was written; "
            "run aegis-podman host-setup again and review both"
        ) + " >&2",
        "    exit 1",
        "fi",
        "if ! rpm -q udica >/dev/null 2>&1; then",
        "    dnf install -y udica",
        "fi",
        " ".join(["semodule", "-i", quote(str(paths.selinux_module)), *map(quote, templates)]),
        f"echo {quote(f'loaded the SELinux module {paths.selinux_module}')}",
        "",
    ]
    for zone in zones:
        lines += [
            f"target=$(firewall-cmd --permanent --zone={quote(zone)} --get-target)",
            'if [ "$target" = ACCEPT ]; then',
            "    echo " + quote(
                f"aegis host setup: warning: zone {zone} accepts every connection (target "
                f"ACCEPT), so port {port} is reachable from any source"
            ) + " >&2",
            "fi",
            f"if firewall-cmd --zone={quote(zone)} --query-port={port}/tcp >/dev/null; then",
            "    echo " + quote(
                f"aegis host setup: warning: zone {zone} already opens {port}/tcp to every "
                "source"
            ) + " >&2",
            "fi",
        ]
        for rule_zone, rule in _rich_rules([zone], port):
            for scope, option in (("permanent", "--permanent "), ("runtime", "")):
                command = f"firewall-cmd {option}--zone={quote(rule_zone)}"
                lines += [
                    f"if {command} --query-rich-rule={quote(rule)} >/dev/null; then",
                    f"    echo {quote(f'already present ({scope}) in zone {zone}: {rule}')}",
                    "else",
                    f"    {command} --add-rich-rule={quote(rule)} >/dev/null",
                    f"    echo {quote(f'added ({scope}) to zone {zone}: {rule}')}",
                    "fi",
                ]
    return "\n".join(lines) + "\n"


def command_host_setup(host: Host, paths: Paths, args: argparse.Namespace) -> int:
    """Write the SELinux module and the host-setup script, for the operator to review and
    run with sudo; the installer itself runs nothing privileged."""
    zones = list(dict.fromkeys(_zone_argument(zone) for zone in args.zone))
    _check_directories(paths, host.uid, create=False)
    with _locked(paths):
        state = _ready_state(paths, host.uid, args)
        zones = zones or list(state.firewall_zones)
        if not zones:
            raise InstallError(
                "name each firewalld zone to admit the HTTPS port in with --zone (repeat it "
                "for more zones)"
            )
        login = _operator_login(host)
        _check_directories(paths, host.uid, create=True)
        _check_replaceable(state, paths.host_setup)
        module = _write_module(host, paths, state)
        script = _host_setup_script(
            paths, login, _inherited_templates(module), zones, state.https_port,
            hashlib.sha256(module.encode("utf-8")).hexdigest(),
        )
        state.firewall_zones = zones
        _publish(paths, state, paths.host_setup, script.encode("utf-8"), "host-setup", 0o700)
        _settle(paths, state)
    _say(host, f"aegis-podman: wrote the SELinux module {paths.selinux_module}:")
    _say(host)
    host.out.write(module)
    _say(host)
    _say(host, f"and the host setup script {paths.host_setup}, which loads it:")
    _say(host)
    host.out.write(script)
    _say(host)
    _say(host, f"Review it and the SELinux module {paths.selinux_module}, then run it with: "
               f"sudo sh {paths.host_setup}")
    if state.selinux_pending:
        _say(host, "Then rerun the aegis-podman roots add command that asked for it.")
    return 0


# -- commands ----------------------------------------------------------------------------------


def _ready_state(paths: Paths, uid: int, args: argparse.Namespace) -> State:
    state = load_state(paths, uid)
    if state is None:
        raise InstallError("nothing is initialized yet; run aegis-podman init first")
    if state.phase != "ready":
        raise InstallError("initialization did not finish; rerun aegis-podman init")
    if args.prefix is not None and args.prefix != state.prefix:
        raise InstallError(f"this install's prefix is {state.prefix}, not {args.prefix}")
    return state


def _installed_state(paths: Paths, uid: int, args: argparse.Namespace) -> State:
    state = _ready_state(paths, uid, args)
    if not state.installed:
        raise InstallError("the units are not installed; run aegis-podman install first")
    return state


def _refuse_pending(state: State) -> None:
    if state.pending is not None:
        release = state.pending["release"]
        raise InstallError(
            f"the upgrade to {release} did not finish; finish it with: aegis-podman upgrade "
            f"--release {release}, or go back with: aegis-podman upgrade --abandon"
        )


def command_init(host: Host, paths: Paths, args: argparse.Namespace) -> int:
    prefix = _prefix_argument(args.prefix)
    local_images = _local_images_argument(args.local_images)
    if local_images is not None:
        _refuse_test_option("--local-images", prefix)
    release = _release_argument(args.release, local_images=local_images is not None)
    reader_type = _reader_type_argument(args.reader_type, prefix)
    registry = _registry_argument(args.registry)
    port = _port_argument(args.https_port)
    names = _names_argument(args.name, args.address)
    requested_subnet = _subnet_argument(args.backend_subnet)
    derivatives = (
        None if args.derivatives_dir is None else _derivatives_argument(args.derivatives_dir)
    )
    hours = _scan_interval_argument(args.scan_interval_hours)
    _check_directories(paths, host.uid, create=False)
    previous = load_state(paths, host.uid)
    if previous is not None and previous.phase != "initializing":
        raise InstallError(
            "aegis-podman is already initialized; use upgrade --release to change the "
            "release, or install to (re)install the units"
        )
    _preflight(host, paths)
    _check_directories(paths, host.uid, create=True)
    with _locked(paths):
        previous = load_state(paths, host.uid)
        if previous is not None and previous.phase != "initializing":
            raise InstallError("aegis-podman is already initialized")
        return _initialize(host, paths, previous, release, registry, prefix, port, names,
                           requested_subnet, local_images=local_images, reader_type=reader_type,
                           derivatives=derivatives, scan_interval_hours=hours)


def _initialize(
    host: Host, paths: Paths, previous: State | None, release: str, registry: str, prefix: str,
    port: int, names: list[str], requested_subnet: str | None, *,
    local_images: Mapping[str, str] | None = None, reader_type: str = PRODUCTION_READER_TYPE,
    derivatives: str | None = None, scan_interval_hours: int | None = None,
) -> int:
    state = State(
        phase="initializing", release=release, registry=registry, prefix=prefix, names=names,
        https_port=port, host_gid=host.gid, backend_subnet="",
        reader_type=reader_type, install_token=secrets.token_hex(16),
        # Only the production prefix may start at boot; a test stack never does.
        install_sections=prefix == PRODUCTION_PREFIX,
        local_images=local_images is not None,
    )
    if previous is not None:  # resume an interrupted init with what it recorded
        state.files, state.secrets, state.releases, state.extractions = (
            previous.files, previous.secrets, previous.releases, previous.extractions,
        )
        state.install_token = previous.install_token
        state.derivatives = previous.derivatives
        state.label_level = previous.label_level
    # Drawn once, here, and kept for the install's lifetime.
    if state.label_level is None:
        state.label_level = new_label_level()
    for name in SECRET_NAMES:
        _secret_ready(paths, state, name)
    _check_replaceable(state, paths.env_file)
    # Checked before anything else runs; prepared and recorded only once nothing else can
    # refuse the init. No unit binds it before install, so another one replaces a recorded one.
    recorded = _usable_derivatives(state)
    adopt = derivatives if derivatives is not None and (
        recorded is None or recorded["path"] != derivatives
    ) else None
    if adopt is not None:
        _check_derivatives_directory(host, paths, state, adopt, None)
    elif recorded is not None:
        _check_derivatives_directory(host, paths, state, recorded["path"], recorded)
    containers = _containers(host)
    _check_port(host, port, containers)
    state.backend_subnet = _choose_subnet(host, requested_subnet)
    save_state(paths, state)
    state.images, state.created = (
        _pull(host, registry, release) if local_images is None else _local(host, local_images)
    )
    save_state(paths, state)
    _extract_release(host, paths, state, release, state.images["backend"])
    module, templates = _release_renderer(paths, state, release)
    if scan_interval_hours is not None and not _takes_scan_interval(module):
        _refuse_scan_interval(release, "initialize it")
    state.scan_interval_hours = scan_interval_hours
    _note_scan_interval(state, module)
    units = _render(module, templates, state, paths)
    inventory, volumes, networks = _inventory(units)
    _refuse_existing_objects(host, containers, inventory, volumes, networks)
    for unit in units.values():
        _check_replaceable(state, unit.path)
    if adopt is not None:
        state.derivatives = _adopt_derivatives(host, paths, state, adopt)
        save_state(paths, state)
    missing = [name for name in SECRET_NAMES if not _secret_ready(paths, state, name)]
    for name in missing:
        _new_secret(host, paths, state, name)
    _write_config(paths, state)
    _record_history(state, release)
    state.phase = "ready"
    _settle(paths, state)
    _say(host, f"aegis-podman: initialized release {release} (prefix {state.prefix})")
    _say(host, f"  HTTPS port {port} for: {', '.join(names)}")
    _say(host, f"  backend subnet {state.backend_subnet}")
    _say(host, "  images, pinned by digest:")
    for role in ROLES:
        _say(host, f"    {role:<9} {state.images[role]}")
    kept = _usable_derivatives(state)
    if kept is not None:
        _say(host, f"  derivatives in {kept['path']}, prepared for the containers")
    _say(host, f"  SELinux level {state.label_level}, shared by every container")
    _say(host, f"  {_scan_interval_text(state)}")
    _say(host, f"  {len(SECRET_NAMES)} secret files in {paths.secrets} (values are never shown)")
    _say(host, "Next: the host setup (SELinux module and firewall rules), then "
               "aegis-podman install and aegis-podman start.")
    return 0


def command_install(host: Host, paths: Paths, args: argparse.Namespace) -> int:
    _check_directories(paths, host.uid, create=False)
    with _locked(paths):
        state = _ready_state(paths, host.uid, args)
        _refuse_pending(state)
        if args.install_sections and state.prefix != PRODUCTION_PREFIX:
            raise InstallError(
                f"only the {PRODUCTION_PREFIX} prefix may have [Install] sections; a stack "
                f"with the prefix {state.prefix} must never start at boot"
            )
        _preflight(host, paths)
        was_enabled = state.installed and state.install_sections
        # The recorded choice holds until a flag changes it explicitly.
        if args.install_sections is not None:
            state.install_sections = args.install_sections
        # A lost release tree comes back from the pinned, already local backend image.
        _extract_release(host, paths, state, state.release, state.images["backend"])
        module, templates = _release_renderer(paths, state, state.release)
        level, drawn = _render_level(state, module)
        if (drawn or _migration_pending(state)) and state.installed and (
            state.desired == "running"
        ):
            raise InstallError(
                "the volumes must be relabelled to the shared SELinux level before any "
                "container runs at it, and install never stops or starts Aegis: run "
                "aegis-podman stop, then install again"
            )
        units = _render(module, templates, dataclasses.replace(state, label_level=level), paths)
        inventory, volumes, networks = _inventory(units)
        _check_backend_network(host, state)
        if not state.installed:
            _check_port(host, state.https_port, _containers(host))
        stale = _stale_units(state, units)
        _check_units(paths, state, units, stale)
        derivatives = _usable_derivatives(state)
        if derivatives is not None and module.RENDER_API >= 2:  # these units bind it
            _check_derivatives(host, paths, state, derivatives)
        # Roots recorded before an uninstall get their drop-ins back; ones in place are kept.
        roles = _root_roles(state.prefix, inventory["containers"])
        rendered = (
            _render_roots(host, paths, state, state.roots, state.release, state.images,
                          roles=roles)
            if state.roots and _roots_need_render(paths, state, roles) else None
        )
        leftover = _leftover_drop_ins(paths, state)
        _note_scan_interval(state, module)
        if drawn:
            assert level is not None
            _adopt_level(state, level, list(state.volumes))
            save_state(paths, state)
        changed = _write_units(host, paths, state, units, stale, DEFAULT_DEADLINE)
        if rendered is not None:
            _install_drop_ins(paths, state, rendered)
        elif leftover:
            _remove_roots(paths, state)
        # After the new units are on disk (a reboot then generates those, at the shared
        # level) and before systemd loads them.
        if module.RENDER_API >= 2:
            _migrate_levels(host, paths, state, DEFAULT_DEADLINE)
        _record_inventory(state, inventory, volumes, networks)
        state.installed = True
        _settle(paths, state)
        _check(host, [*SYSTEMCTL, "daemon-reload"], "systemctl --user daemon-reload", timeout=120)
        _commit_roots(host, paths, state, state.roots)
        socket_unit = inventory["socket"]
        if state.install_sections:
            _check(host, [*SYSTEMCTL, "enable", socket_unit], f"enabling {socket_unit}",
                   timeout=120)
        elif was_enabled:
            _check(host, [*SYSTEMCTL, "disable", socket_unit], f"disabling {socket_unit}",
                   timeout=120)
        states = _unit_states(host, _watched_units(state))
        unloaded = [unit for unit, info in states.items() if info.get("LoadState") != "loaded"]
        if unloaded:
            raise InstallError(
                f"systemd did not load {', '.join(unloaded)}; see what Quadlet generates "
                f"with: {host.quadlet} -dryrun -user"
            )
    _say(host, f"aegis-podman: installed {len(units)} unit files ({len(changed)} changed)")
    for directory in sorted({str(unit.path.parent) for unit in units.values()}):
        _say(host, f"  {directory}")
    if state.install_sections:
        _say(host, f"  {socket_unit} is enabled. The Quadlet services start at boot through "
                   "their [Install] sections, which systemd applies when it generates them.")
    else:
        _say(host, "  no unit has an [Install] section, so nothing starts at boot")
    _say(host, "Next: aegis-podman start" if state.desired == "stopped" else
               "Aegis is running; aegis-podman stop and start apply changed units")
    return 0


def command_start(host: Host, paths: Paths, args: argparse.Namespace) -> int:
    _check_directories(paths, host.uid, create=False)
    with _locked(paths):
        state = _installed_state(paths, host.uid, args)
        _refuse_pending(state)
        unfinished = _migration_pending(state)
        if unfinished:
            raise InstallError(
                f"the volumes {', '.join(unfinished)} are not relabelled to the shared SELinux "
                "level yet, so the containers could not read them; run aegis-podman install "
                "again to finish"
            )
        if _derivatives_bound(paths, state):  # only units that bind it depend on it
            derivatives = _usable_derivatives(state)
            assert derivatives is not None
            _check_derivatives(host, paths, state, derivatives)
        state.desired = "running"
        save_state(paths, state)
        # Quadlet's network and volume services first, so their failures surface early.
        if state.units["generated"]:
            _check(host, [*SYSTEMCTL, "--no-block", "start", *state.units["generated"]],
                   "systemctl --user start", timeout=120)
        _check(
            host,
            [*SYSTEMCTL, "--no-block", "start", state.units["socket"], *state.units["services"]],
            "systemctl --user start", timeout=120,
        )
    # The wait changes nothing, so other commands may read the record meanwhile.
    if not _await_ready(host, state, args.timeout):
        return 1
    _say(host, "aegis-podman: every unit is active, healthy and on its recorded image")
    return 0


def command_stop(host: Host, paths: Paths, args: argparse.Namespace) -> int:
    _check_directories(paths, host.uid, create=False)
    with _locked(paths):
        state = _installed_state(paths, host.uid, args)
        state.desired = "stopped"
        save_state(paths, state)
        _check(
            host, [*SYSTEMCTL, "--no-block", "stop", *_service_units(state)],
            "systemctl --user stop", timeout=120,
        )
    if not _await_stopped(host, _service_units(state), args.timeout):
        return 1
    _say(host, "aegis-podman: stopped")
    return 0


def command_status(host: Host, paths: Paths, args: argparse.Namespace) -> int:
    _check_directories(paths, host.uid, create=False)
    try:
        with _locked(paths, shared=True):
            state = _ready_state(paths, host.uid, args)
    except LockBusy:
        _say(host, "an aegis-podman command is in progress, so this is the live state only, "
                   "without the record's run state, pending upgrade or recovery advice")
        # The record is replaced by atomic renames, so reading it now sees a whole one.
        current = load_state(paths, host.uid)
        if current is None or not current.installed or not current.units:
            return 3
        states = _unit_states(host, _watched_units(current))
        _print_units(host, current, states, _observe(host, current))
        return 3
    leftovers = _leftovers(paths, state.prefix)
    if leftovers:
        _say(host, "Temporary files left by an interrupted run (remove them while no "
                   f"aegis-podman runs): {', '.join(map(str, leftovers))}")
    if not state.installed:
        _say(host, f"release {state.release}: initialized; run aegis-podman install")
        return 3
    states = _unit_states(host, _watched_units(state))
    observed = _observe(host, state)
    pending, failed = _readiness(
        state, states, observed, expect_running=state.desired == "running",
    )
    _print_status(host, state, states, observed, failed)
    interrupted = state.mounts["installing"] is not None or (
        _roots_need_render(paths, state) if state.roots else bool(_drop_in_paths(state))
    )
    if interrupted:
        _say(host, "The roots' drop-ins are not all in place as recorded: an aegis-podman roots "
                   "or install command was interrupted. Run it again, or run aegis-podman "
                   "install to render them again.")
    if state.pending is not None or pending or failed or interrupted:
        return 3
    return 0


def command_upgrade(host: Host, paths: Paths, args: argparse.Namespace) -> int:
    local_images = _local_images_argument(args.local_images)
    if args.abandon and local_images is not None:
        raise InstallError("--local-images goes with --release, not --abandon")
    derivatives = (
        None if args.derivatives_dir is None else _derivatives_argument(args.derivatives_dir)
    )
    if args.abandon and derivatives is not None:
        raise InstallError("--derivatives-dir goes with --release, not --abandon")
    hours = _scan_interval_argument(args.scan_interval_hours)
    if args.abandon and hours is not None:
        raise InstallError("--scan-interval-hours goes with --release, not --abandon")
    release = None if args.abandon else _release_argument(
        args.release, local_images=local_images is not None,
    )
    _check_directories(paths, host.uid, create=False)
    with _locked(paths):
        state = _ready_state(paths, host.uid, args)
        if local_images is not None:
            _refuse_test_option("--local-images", state.prefix)
        recorded = _usable_derivatives(state)
        settled = (derivatives is None or (
            recorded is not None and recorded["path"] == derivatives
        )) and (hours is None or hours == state.scan_interval_hours)
        if args.abandon:
            if state.pending is None:
                raise InstallError("no upgrade is pending, so there is nothing to abandon")
            wait = _abandon(host, paths, args, state)
        elif state.pending is not None:
            if release != state.pending["release"]:
                _refuse_pending(state)
            wait = _upgrade(host, paths, args, state, state.pending["release"], None, resume=True,
                            derivatives=derivatives, scan_interval_hours=hours)
        elif release == state.release and settled:
            _say(host, f"aegis-podman: release {release} is already current; nothing to do")
            return 0
        else:
            # The current release again, too, when it is to adopt a derivatives directory or
            # change the scan interval.
            assert release is not None
            wait = _upgrade(host, paths, args, state, release, local_images, resume=False,
                            derivatives=derivatives, scan_interval_hours=hours)
    # The wait changes nothing, so other commands may read the record meanwhile.
    if not wait:
        return 0
    if not _await_ready(host, state, args.timeout):
        return 1
    _say(host, "aegis-podman: every unit is active, healthy and on its recorded image")
    return 0


def _queue_restart(host: Host, inventory: Mapping[str, Any], changed: set[str]) -> None:
    """Start Quadlet's network and volume services and restart the services, in order.

    An unchanged socket keeps listening, so the kernel queues connections meanwhile.
    Restarting PostgreSQL restarts migrate through Requires=; its dependents wait for it.
    """
    socket_unit = inventory["socket"]
    starts = list(inventory["generated"])
    restart = list(inventory["services"])
    if socket_unit in changed:
        restart.insert(0, socket_unit)
    else:
        starts.append(socket_unit)
    _check(host, [*SYSTEMCTL, "--no-block", "start", *starts], "systemctl --user start",
           timeout=120)
    _check(host, [*SYSTEMCTL, "--no-block", "restart", *restart], "systemctl --user restart",
           timeout=120)


def _boot_id(host: Host) -> str | None:
    """This boot's ID, or None when the kernel does not tell."""
    try:
        text = host.boot_id.read_text(encoding="ascii").strip()
    except (OSError, UnicodeDecodeError):
        return None
    return text if BOOT_ID.fullmatch(text) else None


def _restart_may_have_run(host: Host, pending: Mapping[str, Any]) -> bool:
    """Whether the pending release's units may already have run, so that its migrations may
    have changed the schema: its restart was queued, or the host rebooted since the upgrade
    recorded it (the boot generated the new units, already on disk, and the socket or a
    manual start may have started them). A boot that cannot be read now counts as another."""
    if pending.get("restart_queued"):
        return True
    recorded = pending.get("boot_id")
    return recorded is not None and recorded != _boot_id(host)


def _abandon(host: Host, paths: Paths, args: argparse.Namespace, state: State) -> bool:
    """Go back from a pending upgrade to the current release; True when a wait follows.

    The current release's units are rendered and installed again, and units only the
    pending release had are stopped and removed. After ``daemon-reload`` the pending record
    is cleared. The run state stays: a running stack is restarted on the current release's
    images, and a stopped one stays stopped.
    """
    assert state.pending is not None
    abandoned = state.pending["release"]
    if _restart_may_have_run(host, state.pending):
        cause = (
            f"the restart into {abandoned} was already queued"
            if state.pending.get("restart_queued") else
            f"the host rebooted while the upgrade to {abandoned} was pending, so its units, "
            "already on disk, may have started"
        )
        backup = (f"{cause}, so its migrations may have changed the database schema, and "
                  f"{state.release} may not run on it. Restore a database backup from before "
                  "the upgrade first")
        if not args.allow_downgrade:
            raise InstallError(f"{backup}, then rerun with --allow-downgrade")
        print(f"aegis-podman: warning: {backup}.", file=host.err)
    next_step = (f"; the upgrade to {abandoned} is still pending: go back again with "
                 f"aegis-podman upgrade --abandon, or finish it with aegis-podman upgrade "
                 f"--release {abandoned}")
    if "previous_derivatives" in state.pending:
        # A directory this upgrade adopted goes with it; the directory itself stays prepared,
        # and a later --derivatives-dir can take it again.
        state.derivatives = state.pending["previous_derivatives"]
        save_state(paths, state)
    try:
        running, inventory, volumes, networks = _abandon_units(host, paths, args, state)
    except InstallError as error:
        raise InstallError(f"{error}{next_step}") from None
    except BaseException:
        print(f"aegis-podman: stopped part-way{next_step}", file=host.err)
        raise
    state.pending = None
    _record_inventory(state, inventory, volumes, networks)
    _write_config(paths, state)
    _commit_roots(host, paths, state, state.roots)
    _say(host, f"aegis-podman: abandoned the upgrade to {abandoned}; release {state.release}'s "
               "units are installed again")
    if not running:
        _say(host, "Aegis is stopped, so nothing was restarted")
    return running


def _abandon_units(
    host: Host, paths: Paths, args: argparse.Namespace, state: State,
) -> tuple[bool, dict[str, Any], list[str], list[str]]:
    """Install the current release's units again; restart them when Aegis should run.

    Going back to a release before the shared SELinux level, whose containers run at random
    levels again, relabels the volumes already moved to the shared level to s0, which every
    level reads, and forgets the level: the next upgrade draws one and migrates again.
    """
    _preflight(host, paths)
    _extract_release(host, paths, state, state.release, state.images["backend"])
    module, templates = _release_renderer(paths, state, state.release)
    level, drawn = _render_level(state, module)
    units = _render(module, templates, dataclasses.replace(state, label_level=level), paths)
    inventory, volumes, networks = _inventory(units)
    _check_backend_network(host, state)
    stale = _stale_units(state, units)
    _check_units(paths, state, units, stale)
    _check_replaceable(state, paths.env_file)
    _note_scan_interval(state, module)
    # The drop-ins go back to the current release's aegisctl render too: one for each root
    # role that release has a unit for.
    rendered = (
        _render_roots(host, paths, state, state.roots, state.release, state.images,
                      roles=_root_roles(state.prefix, inventory["containers"]))
        if state.roots else None
    )
    leftover = _leftover_drop_ins(paths, state)
    running = state.desired == "running"
    if module.RENDER_API < 2 and state.label_level is not None:
        moved = [name for name, done in (state.level_migration or {}).items() if done]
        _relabel_volumes(host, paths, state, moved, "s0", migrated=False, timeout=args.timeout)
        state.label_level = state.level_migration = None
        save_state(paths, state)
    elif module.RENDER_API >= 2:
        if drawn:
            assert level is not None
            _adopt_level(state, level, list(state.volumes))
            save_state(paths, state)
        _migrate_levels(host, paths, state, args.timeout)
    changed = _write_units(host, paths, state, units, stale, args.timeout)
    if rendered is not None:
        _install_drop_ins(paths, state, rendered)
    elif leftover:
        _remove_roots(paths, state)
    _check(host, [*SYSTEMCTL, "daemon-reload"], "systemctl --user daemon-reload", timeout=120)
    if running:
        _queue_restart(host, inventory, changed)
    return running, inventory, volumes, networks


def _upgrade(
    host: Host, paths: Paths, args: argparse.Namespace, state: State, release: str,
    local_images: Mapping[str, str] | None, *, resume: bool, derivatives: str | None = None,
    scan_interval_hours: int | None = None,
) -> bool:
    """Move to ``release`` in two phases; True when a wait for readiness follows.

    Phase one records the release as pending and writes its units; phase two, after
    ``daemon-reload`` succeeded and any restart is queued, makes it current. A run that
    stops in between leaves the pending record: the same command finishes it, and
    ``upgrade --abandon`` goes back. ``local_images`` are the deployment test's images,
    used by ID in place of a pull; a test release is never ordered by its creation label.
    ``derivatives`` adopts that directory for the derivatives volume once the images are in
    place (``_derivatives_request`` says when it can). It is prepared then, and recorded with
    the pending record, so a failure before that leaves nothing recorded.
    ``scan_interval_hours`` replaces the recorded scan interval; without it, a resumed upgrade
    keeps the one it began with and any other keeps the recorded one (the default for a record
    from before it). It is recorded with the pending record, and becomes the install's only
    when the release does, so an abandon keeps the previous one. A release from before the
    setting refuses it, scans hourly, and keeps the recorded one for a later release.
    """
    _preflight(host, paths)
    adopt = _derivatives_request(host, paths, state, derivatives)
    if resume:
        assert state.pending is not None
        images, created = dict(state.pending["images"]), state.pending.get("created")
        local = bool(state.pending.get("local_images", False))
        for reference in images.values():
            if _run(host, [*PODMAN, "image", "exists", reference], timeout=60).returncode:
                raise InstallError(f"{reference} is not local; fetch it with: podman pull "
                                   f"{reference}")
    else:
        local = local_images is not None
        if local_images is None:
            images, created = _pull(host, state.registry, release)
        else:
            images, created = _local(host, local_images)
        if not (TEST_RELEASE.fullmatch(release) or TEST_RELEASE.fullmatch(state.release)):
            _check_order(state, release, created, args.allow_downgrade)
    planned = _usable_derivatives(state)
    if adopt:
        assert derivatives is not None
        planned = _adopt_derivatives(host, paths, state, derivatives)
    _extract_release(host, paths, state, release, images["backend"])
    module, templates = _release_renderer(paths, state, release)
    if module.RENDER_API < 2 and state.label_level is not None:
        raise InstallError(
            f"release {release} runs every container at a random SELinux level, which cannot "
            f"read the volumes moved to this install's level {state.label_level}; going back "
            "is upgrade --abandon from a pending upgrade, or a restore"
        )
    hours = scan_interval_hours
    if hours is None and resume:
        hours = (state.pending or {}).get("scan_interval_hours")
    if not _takes_scan_interval(module):
        if scan_interval_hours is not None:
            _refuse_scan_interval(release, "upgrade to it")
        hours = state.scan_interval_hours  # kept for a later release that takes it
    elif hours is None:
        hours = _scan_interval_hours(state)
    level, drawn = _render_level(state, module)
    if planned is not None and module.RENDER_API >= 2:  # these units bind it
        _check_derivatives(host, paths, state, planned)
    candidate = dataclasses.replace(
        state, release=release, images=images, local_images=local, label_level=level,
        derivatives=planned, scan_interval_hours=hours,
    )
    units = _render(module, templates, candidate, paths)
    inventory, volumes, networks = _inventory(units)
    _check_backend_network(host, state)
    if not state.installed:
        state.release, state.images, state.created = release, images, created
        state.local_images = local
        state.scan_interval_hours = hours
        _note_scan_interval(state, module)
        state.pending = None
        if drawn:  # nothing runs; install relabels the recorded volumes before it writes units
            assert level is not None
            _adopt_level(state, level, list(state.volumes))
        state.derivatives = planned
        _record_history(state, release)
        _check_replaceable(state, paths.env_file)
        _write_config(paths, state)
        _settle(paths, state)
        _say(host, f"aegis-podman: release {release} is current; the units are not installed")
        return False
    stale = _stale_units(state, units)
    _check_units(paths, state, units, stale)
    _check_replaceable(state, paths.env_file)
    # The new release's aegisctl renders the drop-ins (their Exec= replaces the template's).
    # Rendering first leaves nothing pending when a root cannot be observed.
    rendered = (
        _render_roots(host, paths, state, state.roots, release, images, local_images=local,
                      roles=_root_roles(state.prefix, inventory["containers"]))
        if state.roots else None
    )
    leftover = _leftover_drop_ins(paths, state)
    # What the derivatives record was before this upgrade, which an abandon restores.
    previous_derivatives = (
        (state.pending or {}).get("previous_derivatives", state.derivatives) if resume
        else state.derivatives
    )
    # A resumed upgrade whose restart may already have run stays one: going back from it is
    # a downgrade.
    queued = resume and _restart_may_have_run(host, state.pending or {})
    state.pending = {
        "release": release, "images": images, "created": created, "local_images": local,
        "previous_derivatives": previous_derivatives, "boot_id": _boot_id(host),
        "scan_interval_hours": hours, **({"restart_queued": True} if queued else {}),
    }
    if drawn:  # with the pending record, so an interrupted migration resumes or goes back
        assert level is not None
        _adopt_level(state, level, list(state.volumes))
    # The adopted directory, with the pending record: an abandon keeps it unbound, replaceable.
    state.derivatives = planned
    # Objects the new units may create are recorded now, so a purge finds them either way.
    state.volumes = list(dict.fromkeys([*state.volumes, *volumes]))
    state.networks = list(dict.fromkeys([*state.networks, *networks]))
    save_state(paths, state)
    moving = bool(_migration_pending(state)) and module.RENDER_API >= 2
    finish = (
        "; the upgrade is pending" + (
            " while the volumes move to the shared SELinux level: start nothing by hand, and "
            "after a reboot run the upgrade again before using Aegis" if moving else ""
        ) + f": finish it with aegis-podman upgrade --release {release}, or go back with "
        "aegis-podman upgrade --abandon"
    )
    running = state.desired == "running"
    try:
        changed = _write_units(host, paths, state, units, stale, args.timeout)
        if rendered is not None:
            _install_drop_ins(paths, state, rendered)
        elif leftover:
            _remove_roots(paths, state)
        if module.RENDER_API >= 2:
            # One time, for a record from before the shared level: stop everything, then move
            # the volumes recorded before it to that level. The new units are already on disk,
            # so a reboot generates those; systemd loads them only after the move.
            _migrate_levels(host, paths, state, args.timeout)
        _check(host, [*SYSTEMCTL, "daemon-reload"], "systemctl --user daemon-reload", timeout=120)
        if running:
            # From here on the new release's migrate may run, so going back is a downgrade.
            state.pending["restart_queued"] = True
            save_state(paths, state)
            _queue_restart(host, inventory, changed)
        else:
            _renew_derivatives_volume(host, state, args.timeout)
    except InstallError as error:
        raise InstallError(f"{error}{finish}") from None
    except BaseException:
        print(f"aegis-podman: stopped part-way{finish}", file=host.err)
        raise
    state.release, state.images, state.created = release, images, created
    state.local_images = local
    state.scan_interval_hours = hours
    _note_scan_interval(state, module)
    state.pending = None
    _record_history(state, release)
    _record_inventory(state, inventory, volumes, networks)
    _write_config(paths, state)
    _commit_roots(host, paths, state, state.roots)
    _say(host, f"aegis-podman: release {release} is current; the previous release tree stays")
    if not running:
        _say(host, "Aegis is stopped, so nothing was restarted; start it with: "
                   "aegis-podman start")
    return running


def _der_sequence(der: bytes) -> bool:
    """Whether ``der`` is exactly one DER SEQUENCE, as an X.509 certificate is."""
    if len(der) < 2 or der[0] != 0x30:
        return False
    length, offset = der[1], 2
    if length & 0x80:
        count = length & 0x7F
        if not 1 <= count <= 4 or len(der) < 2 + count:
            return False
        length, offset = int.from_bytes(der[2:2 + count], "big"), 2 + count
    return offset + length == len(der)


def _single_certificate(text: str) -> str:
    match = PEM_CERTIFICATE.fullmatch(text)
    if match is None:
        raise InstallError("Caddy's root certificate file is not exactly one PEM certificate")
    try:
        der = base64.b64decode("".join(match.group(1).split()), validate=True)
    except binascii.Error:
        raise InstallError("Caddy's root certificate is not valid base64") from None
    if not _der_sequence(der):
        raise InstallError("Caddy's root certificate is not a DER certificate")
    return f"-----BEGIN CERTIFICATE-----\n{match.group(1)}-----END CERTIFICATE-----\n"


def command_ca_cert(host: Host, paths: Paths, args: argparse.Namespace) -> int:
    _check_directories(paths, host.uid, create=False)
    try:
        with _locked(paths, shared=True):
            state = _installed_state(paths, host.uid, args)
    except LockBusy:
        print("aegis-podman: another command is in progress; reading the record without it",
              file=host.err)
        # The record is replaced by atomic renames, so reading it now sees a whole one.
        state = _installed_state(paths, host.uid, args)
    container = state.units["containers"].get(f"{state.prefix}caddy.service")
    if container is None:
        raise InstallError("the Caddy unit is not recorded; rerun aegis-podman install")
    result = _check(
        host, [*PODMAN, "exec", container, "cat", CA_CERTIFICATE],
        "reading Caddy's local root certificate", timeout=60,
    )
    host.out.write(_single_certificate(result.stdout))
    return 0


def _bootstrap_options(text: str, state: State, paths: Paths) -> list[str]:
    """``podman run`` options with the web unit's user, environment, secrets and confinement."""
    container = _unit_sections(text).get("Container", [])
    unknown = sorted({key for key, _ in container} - BOOTSTRAP_COPIED - BOOTSTRAP_IGNORED)
    if unknown:
        raise InstallError(
            f"the web unit sets {', '.join(unknown)}, which this aegis-podman cannot copy to "
            "the one-off container; run the installed release's own aegis-podman"
        )
    if [value for key, value in container if key == "Image"] != [state.images["backend"]]:
        raise InstallError("the installed web unit does not run the recorded backend image")
    users = [value for key, value in container if key == "User"]
    groups = [value for key, value in container if key == "Group"]
    options = [f"--user={users[0]}" + (f":{groups[0]}" if groups else "")] if users else []
    secret_binds = f"{paths.secrets}/"
    for key, value in container:
        if key == "Environment":
            words = shlex.split(value)
            if len(words) != 1 or "=" not in words[0]:
                raise InstallError(f"cannot read the web unit's Environment={value}")
            options.append(f"--env={words[0]}")
        elif key == "Volume" and value.startswith(secret_binds):
            options.append(f"--volume={value}")
        elif key == "ReadOnly" and value == "true":
            options.append("--read-only")
        elif key == "Tmpfs":
            options.append(f"--tmpfs={value}")
        elif key == "DropCapability":
            options.extend(f"--cap-drop={capability.lower()}" for capability in value.split())
        elif key == "AddCapability":
            options.extend(f"--cap-add={capability.lower()}" for capability in value.split())
        elif key == "NoNewPrivileges" and value == "true":
            options.append("--security-opt=no-new-privileges")
        elif key == "Unmask":
            options.append(f"--security-opt=unmask={value}")
        elif key == "GIDMap":
            options.append(f"--gidmap={value}")
        elif key == "SecurityLabelType":
            options.append(f"--security-opt=label=type:{value}")
        elif key == "SecurityLabelLevel":
            options.append(f"--security-opt=label=level:{value}")
        elif key == "RunInit" and value == "true":
            options.append("--init")
    return options


def command_bootstrap_password(host: Host, paths: Paths, args: argparse.Namespace) -> int:
    if USERNAME.fullmatch(args.username) is None:
        raise InstallError("--username must be 1 to 150 letters, digits or @.+_-, "
                           "starting with a letter or digit")
    if EMAIL.fullmatch(args.email) is None:
        raise InstallError("--email must be a plain address such as admin@example.org")
    _check_directories(paths, host.uid, create=False)
    with _locked(paths):
        state = _installed_state(paths, host.uid, args)
        _refuse_pending(state)
        web = next(
            (Path(path) for path, record in state.files.items()
             if record.get("kind") == "unit"
             and Path(path).name == f"{state.prefix}web.container"),
            None,
        )
        if web is None:
            raise InstallError("the web unit is not recorded; rerun aegis-podman install")
        content = _read_regular(web)
        if hashlib.sha256(content).hexdigest() not in _accepted(state.files[str(web)]):
            raise InstallError(f"{web} was changed since aegis-podman wrote it")
        try:
            options = _bootstrap_options(content.decode("utf-8"), state, paths)
        except UnicodeDecodeError:
            raise InstallError(f"{web} is not UTF-8") from None
        password_file = paths.secrets / BOOTSTRAP_PASSWORD
        if not _secret_ready(paths, state, BOOTSTRAP_PASSWORD):
            password = _new_secret(host, paths, state, BOOTSTRAP_PASSWORD)
            _say(host, "A new administrator password was generated. This is the only time it "
                       f"is shown; it is stored only in {password_file} (mode 0600, readable "
                       "by the container user). Save it in a password manager now:")
            _say(host, f"  {password}")
        result = _run(
            host,
            [*PODMAN, "run", "--rm", "--pull=never", f"--network={state.prefix}backend",
             *options, f"--volume={password_file}:{BOOTSTRAP_TARGET}:ro",
             state.images["backend"], "python", "manage.py", "bootstrap_admin",
             "--username", args.username, "--email", args.email,
             "--password-file", BOOTSTRAP_TARGET],
            timeout=600,
        )
    if result.returncode != 0:
        raise InstallError(
            f"administrator bootstrap failed (exit {result.returncode}){_detail(result.stderr)}"
        )
    host.out.write(result.stdout)
    return 0


def _uninstall_units(
    host: Host, paths: Paths, state: State, *, force: bool, timeout: float,
) -> None:
    units = [Path(path) for path, record in state.files.items() if record.get("kind") == "unit"]
    drop_ins = _drop_in_paths(state)
    for path in [*units, *drop_ins]:
        _check_removable(paths, state, path, force=force)
    # The recorded inventory, and every unit a recorded file defines, including units only a
    # pending upgrade wrote.
    everything = list(dict.fromkeys([
        *_watched_units(state), *(_systemd_unit(path.name) for path in units),
    ]))
    # Units that systemd never loaded cannot be stopped; polling then sees them inactive.
    _run(host, [*SYSTEMCTL, "--no-block", "stop", *everything], timeout=120)
    if not _await_stopped(host, everything, timeout):
        raise InstallError("the units did not stop; nothing was removed")
    state.desired = "stopped"
    socket_unit = state.units["socket"]
    socket_file = next((path for path in units if path.name == socket_unit), None)
    if state.install_sections and socket_file is not None and os.path.lexists(socket_file):
        _check(host, [*SYSTEMCTL, "disable", socket_unit], f"disabling {socket_unit}", timeout=120)
    elif socket_file is not None:
        # The file is gone, so systemctl cannot disable it: remove exactly the link
        # enable created, when it still points at the recorded file.
        wants = paths.config / "systemd" / "user" / "sockets.target.wants" / socket_unit
        if wants.is_symlink() and os.readlink(wants) == str(socket_file):
            wants.unlink()
    for path in units:
        _remove_recorded(paths, state, path)
    # The roots stay recorded; install renders their drop-ins again.
    _remove_drop_ins(paths, state, drop_ins)
    state.installed = False
    state.units = {}
    state.pending = None  # its units are gone with the others
    save_state(paths, state)
    try:
        _check(host, [*SYSTEMCTL, "daemon-reload"], "systemctl --user daemon-reload", timeout=120)
    except InstallError as error:
        raise InstallError(f"{error}; the unit files are removed, so run "
                           "systemctl --user daemon-reload yourself") from None


def _purge(host: Host, paths: Paths, state: State, *, force: bool) -> list[Path]:
    """Remove the recorded objects, secrets and files, then the record itself.

    Everything is verified first; one mismatch and nothing is removed. A volume or network
    is removed by exact name, and only when it carries this install's label. Returns the
    temporary files of interrupted runs, which are left in place.
    """
    problems: list[str] = []
    removable: dict[str, list[str]] = {"volume": [], "network": []}
    for kind, names in (("volume", state.volumes), ("network", state.networks)):
        for name in names:
            labels = _object_labels(host, kind, name)
            if labels is None:
                continue
            if labels.get(INSTALL_LABEL) == state.install_token:
                removable[kind].append(name)
            else:
                problems.append(
                    f"{kind} {name} does not carry this install's label, so it is left in "
                    f"place (podman {kind} rm {name} removes it, if you know it is Aegis's)"
                )
    secret_files: list[Path] = []
    for name, record in state.secrets.items():
        path = Path(record["pending"]) if "pending" in record else paths.secrets / name
        info = _lstat(path)
        if info is None:
            continue
        if path.parent != paths.secrets:
            problems.append(f"the record names {path} as a secret outside {paths.secrets}")
        elif force or _same_file(info, record) or ("pending" in record and "device" not in record):
            secret_files.append(path)
        else:
            problems.append(
                f"{path} is not the secret aegis-podman created; rerun with --force-recorded "
                "to remove it anyway"
            )
    generation_files: list[Path] = []
    for generation, record in state.mounts["generations"].items():
        removable_files, found = _generation_files(paths, generation, record, force=force)
        generation_files += removable_files
        problems += found
    files = [Path(path) for path in state.files]
    for path in files:
        try:
            _check_removable(paths, state, path, force=force)
        except InstallError as error:
            problems.append(str(error))
    if problems:
        raise InstallError("nothing was purged:\n  " + "\n  ".join(problems))
    _remove_extractions(host, paths, state)
    for kind, names in removable.items():
        for name in names:
            _check(host, [*PODMAN, kind, "rm", name], f"removing the {kind} {name}", timeout=120)
    for path in [*secret_files, *generation_files, *files]:
        with contextlib.suppress(FileNotFoundError):
            os.unlink(path)
    for path in _drop_in_paths(state):
        with contextlib.suppress(OSError):
            path.parent.rmdir()
    for release in state.releases:
        _remove_empty_directories(paths.releases / release)
    leftovers = _leftovers(paths, state.prefix)
    os.unlink(paths.state)
    with contextlib.suppress(FileNotFoundError):
        os.unlink(paths.lock)
    for directory in (paths.secrets, paths.releases, paths.mounts, paths.selinux,
                      paths.config_directory, paths.data):
        with contextlib.suppress(OSError):
            directory.rmdir()
    return leftovers


def command_uninstall(host: Host, paths: Paths, args: argparse.Namespace) -> int:
    _check_directories(paths, host.uid, create=False)
    if not paths.data.is_dir():
        raise InstallError("nothing is recorded, so there is nothing to uninstall")
    with _locked(paths):
        state = load_state(paths, host.uid)
        if state is None:
            raise InstallError("nothing is recorded, so there is nothing to uninstall")
        if args.prefix is not None and args.prefix != state.prefix:
            raise InstallError(f"this install's prefix is {state.prefix}, not {args.prefix}")
        if state.installed:
            _uninstall_units(host, paths, state, force=args.force_recorded, timeout=args.timeout)
            _say(host, "aegis-podman: removed the recorded unit files")
        if not args.purge_data:
            _say(host, "Volumes, secrets and the record are kept; --purge-data removes them.")
            return 0
        leftovers = _purge(host, paths, state, force=args.force_recorded)
    _say(host, "aegis-podman: removed the recorded volumes, networks, secrets and records; "
               "pulled images are kept")
    kept = _usable_derivatives(state)
    if kept is not None:
        # Removing the volume only unbinds it: the operator's directory is never touched.
        _say(host, f"The derivatives directory {kept['path']} is kept as it is, "
                   "with its content, which the container user owns")
    if state.firewall_zones:
        # The installer never runs anything privileged: the operator reviews and runs these.
        _say(host, "The host setup's firewall rules and SELinux module stay loaded. To undo "
                   "them, review these commands and run them with sudo. Remove only the rules "
                   'the script reported as "added": one it found "already present" was there '
                   "before Aegis and must stay.")
        for zone, rule in _rich_rules(state.firewall_zones, state.https_port):
            for option in ("--permanent ", ""):
                _say(host, f"  firewall-cmd {option}--zone={shlex.quote(zone)} "
                           f"--remove-rich-rule={shlex.quote(rule)}")
        _say(host, "  semodule -r aegis_reader")
    if leftovers:
        _say(host, f"Left in place, from an interrupted run: {', '.join(map(str, leftovers))}")
    return 0


COMMANDS: dict[str, Callable[[Host, Paths, argparse.Namespace], int]] = {
    "init": command_init,
    "install": command_install,
    "start": command_start,
    "stop": command_stop,
    "status": command_status,
    "upgrade": command_upgrade,
    "ca-cert": command_ca_cert,
    "bootstrap-password": command_bootstrap_password,
    "roots": command_roots,
    "host-setup": command_host_setup,
    "uninstall": command_uninstall,
}


def _seconds(text: str) -> float:
    try:
        value = float(text)
    except ValueError:
        raise argparse.ArgumentTypeError(f"{text!r} is not a number of seconds") from None
    if not 0 < value <= 86400:
        raise argparse.ArgumentTypeError("the deadline must be between 0 and 86400 seconds")
    return value


def _parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="aegis-podman", allow_abbrev=False,
        description="Install and run Aegis as rootless Podman Quadlet units.",
    )
    common = argparse.ArgumentParser(add_help=False, allow_abbrev=False)
    common.add_argument(
        "--prefix", help=f"unit and object name prefix (default {PRODUCTION_PREFIX}); after "
                         "init it must match the recorded one",
    )
    common.add_argument(
        "--state-home", metavar="DIRECTORY",
        help="keep the record, secrets, release trees and configuration here instead of the "
             "XDG data and configuration directories (unit files still go where systemd "
             "reads them)",
    )
    commands = parser.add_subparsers(dest="command", required=True, metavar="command")

    def command(name: str, summary: str) -> argparse.ArgumentParser:
        return commands.add_parser(
            name, help=summary, description=summary, allow_abbrev=False, parents=[common],
        )

    def deadline(subparser: argparse.ArgumentParser) -> None:
        subparser.add_argument(
            "--timeout", type=_seconds, default=DEFAULT_DEADLINE, metavar="SECONDS",
            help=f"how long to wait for systemd (default {DEFAULT_DEADLINE:g})",
        )

    init = command("init", "pull a release, choose a subnet, create the secrets and records")
    init.add_argument("--release", required=True, help="the published tag, sha-<commit>")
    init.add_argument("--https-port", required=True, type=int, help="1024 or higher")
    init.add_argument("--name", required=True, action="append",
                      help="hostname or IP address (repeatable; the first is canonical)")
    init.add_argument("--address", action="append", default=[],
                      help="an IP address clients use; repeat for more")
    init.add_argument("--registry", default=DEFAULT_REGISTRY)
    init.add_argument("--backend-subnet", help="a free private /24 instead of the first free "
                                               "candidate")
    derivatives_help = (
        "an empty directory of yours, outside every root and on a disk, for the media "
        "thumbnails, previews and transcodes (default: a Podman volume). It is prepared for "
        "the containers and recorded, and never changes afterwards"
    )
    init.add_argument("--derivatives-dir", metavar="DIRECTORY", help=derivatives_help)
    scan_help = (
        f"hours the indexer waits between scans of each root, 1 to {MAX_SCAN_INTERVAL_HOURS}"
    )
    init.add_argument("--scan-interval-hours", type=int, metavar="HOURS", help=(
        f"{scan_help} (default {DEFAULT_SCAN_INTERVAL_HOURS})"
    ))
    # The deployment test's options (spec D12), hidden from help and refused for the
    # production prefix: images built locally, used by ID, and plain container_t readers.
    init.add_argument("--local-images", help=argparse.SUPPRESS)
    init.add_argument("--reader-type", help=argparse.SUPPRESS)
    install = command("install", "render the release's units and install them for systemd")
    sections = install.add_mutually_exclusive_group()
    sections.add_argument(
        "--install-sections", dest="install_sections", action="store_const", const=True,
        help=f"render [Install] sections, so Aegis starts at boot (the {PRODUCTION_PREFIX} "
             "prefix only)",
    )
    sections.add_argument(
        "--no-install-sections", dest="install_sections", action="store_const", const=False,
        help="render no [Install] sections, so nothing starts at boot. The choice is "
             "recorded and kept until one of these flags changes it",
    )
    deadline(command("start", "start the socket and services and wait until healthy"))
    deadline(command("stop", "stop the socket and services"))
    command("status", "show each unit, its health and the pinned images")
    upgrade = command("upgrade", "move to another release; restart in order when running")
    target = upgrade.add_mutually_exclusive_group(required=True)
    target.add_argument("--release", help="the release to move to, or to finish moving to")
    target.add_argument("--abandon", action="store_true",
                        help="go back from a pending upgrade to the current release")
    upgrade.add_argument("--allow-downgrade", action="store_true",
                         help="allow an older release, one that cannot be ordered, or "
                              "--abandon after the restart into the new release was queued")
    upgrade.add_argument("--derivatives-dir", metavar="DIRECTORY", help=(
        f"{derivatives_help}. Adopting one needs Aegis stopped and no derivatives volume yet"
    ))
    upgrade.add_argument("--scan-interval-hours", type=int, metavar="HOURS", help=(
        f"{scan_help} (default: the recorded one, or {DEFAULT_SCAN_INTERVAL_HOURS} for an "
        "install from before the setting)"
    ))
    upgrade.add_argument("--local-images", help=argparse.SUPPRESS)
    deadline(upgrade)
    command("ca-cert", "print Caddy's local root certificate for client devices")
    bootstrap = command("bootstrap-password", "create the first administrator")
    bootstrap.add_argument("--username", required=True)
    bootstrap.add_argument("--email", required=True)
    roots = commands.add_parser(
        "roots", help="add or remove a read-only original root",
        description="add or remove a read-only original root", allow_abbrev=False,
    )
    actions = roots.add_subparsers(dest="roots_command", required=True, metavar="action")
    add = actions.add_parser(
        "add", help="add a root, or render an existing one again", allow_abbrev=False,
        description="Add a read-only root. When its SELinux type is new, the module is "
                    "regenerated and the command stops with exit code 4 until a probe shows "
                    "that the host setup has loaded it.", parents=[common],
    )
    add.add_argument("--slot", required=True, help="the root's slot ID, such as photos")
    add.add_argument("--source", required=True,
                     help="the existing directory; it is only ever mounted read-only")
    add.add_argument("--identity",
                     help="the expected identity, local:<device>:<inode> or "
                          "remote:<host>:<path> (default: the source's identity now)")
    deadline(add)
    remove = actions.add_parser("remove", help="remove a root", description="remove a root",
                                allow_abbrev=False, parents=[common])
    remove.add_argument("--slot", required=True, help="the root's slot ID")
    deadline(remove)
    host_setup = command("host-setup", "write the SELinux module and the firewall and SELinux "
                                       "host setup script, for you to review and run with sudo")
    host_setup.add_argument("--zone", action="append", default=[],
                            help="a firewalld zone to admit the HTTPS port in, from private "
                                 "sources only; repeat for more (default: the recorded zones)")
    uninstall = command("uninstall", "stop and remove the recorded units")
    uninstall.add_argument("--purge-data", action="store_true",
                           help="also remove the recorded volumes, networks, secrets and records")
    uninstall.add_argument("--force-recorded", action="store_true",
                           help="remove recorded files even when they changed")
    deadline(uninstall)
    return parser


def main(argv: Sequence[str] | None = None, host: Host | None = None) -> int:
    args = _parser().parse_args(argv)
    host = Host(home=Path.home()) if host is None else host
    try:
        if host.uid == 0:
            raise InstallError("run aegis-podman as the operator account, never as root")
        paths = Paths.resolve(host.home, host.environ, args.state_home)
        return COMMANDS[args.command](host, paths, args)
    except (InstallError, RenderError) as error:
        print(f"aegis-podman: error: {error}", file=host.err)
    except OSError as error:
        where = f" ({error.filename})" if error.filename else ""
        print(f"aegis-podman: error: {error.strerror or error}{where}", file=host.err)
    except (KeyError, TypeError, ValueError) as error:
        print(f"aegis-podman: error: unexpected {type(error).__name__} ({error}); the command "
              "stopped part-way, so check aegis-podman status", file=host.err)
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
