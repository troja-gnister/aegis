# Mirrors compose.yaml service `indexer`.
[Unit]
Description=Aegis indexer worker
Requires=@@PREFIX@@migrate.container
After=@@PREFIX@@migrate.container
StartLimitIntervalSec=0

[Container]
ContainerName=@@PREFIX@@indexer
Image=@@IMAGE_BACKEND@@
# The installer pulls the release images; a boot never reaches a registry.
Pull=never
Exec=python manage.py run_role --role indexer
User=10001
Group=10001
RunInit=true
Environment=AEGIS_ENV=production
Environment=AEGIS_RELEASE_ID=@@RELEASE@@
Environment=AEGIS_PUBLIC_URL=@@PUBLIC_URL@@
Environment=AEGIS_ALLOWED_HOSTS=@@ALLOWED_HOSTS@@
Environment=AEGIS_DB_HOST=postgres
Environment=AEGIS_DB_PORT=5432
Environment=AEGIS_DB_NAME=aegis
Environment=AEGIS_SCAN_INTERVAL_SECONDS=@@SCAN_INTERVAL_SECONDS@@
Environment=AEGIS_SCAN_IDLE_TIMEOUT_SECONDS=120
Environment=AEGIS_SCAN_BATCH_RECORDS=500
Environment=AEGIS_SCAN_READERS=2
Environment=AEGIS_DJANGO_SECRET_KEY_FILE=/run/secrets/django_secret_key
Environment=DJANGO_SETTINGS_MODULE=aegis.settings.production
Environment=AEGIS_PROCESS_ROLE=indexer
Environment=AEGIS_DB_USER=aegis_indexer
Environment=AEGIS_DB_PASSWORD_FILE=/run/secrets/db_indexer_password
Network=@@PREFIX@@backend.network:alias=indexer
Volume=@@PREFIX@@indexer-coordination.volume:/srv/aegis/indexer-coordination
ReadOnly=true
Tmpfs=/tmp:size=64m,noexec,nosuid,nodev
DropCapability=ALL
NoNewPrivileges=true
Unmask=/sys/devices/virtual/powercap
# D5: read originals through the operator's group only; D6: the read-only reader type.
GIDMap=+g10001:@@@HOST_GID@@:1
SecurityLabelType=@@READER_TYPE@@
# One SELinux MCS level, drawn per install, for every Aegis container: a file carries its
# creator's level, so the containers exchange files on shared volumes, while every other
# container's own level keeps it out.
SecurityLabelLevel=@@LABEL_LEVEL@@
# Compose's file secrets are read-only binds. The installer owns these files: mode 0600,
# owned by container 10001:10001, labeled container_file_t.
Volume=@@SECRETS_DIR@@/django-secret-key:/run/secrets/django_secret_key:ro
Volume=@@SECRETS_DIR@@/db-indexer-password:/run/secrets/db_indexer_password:ro
HealthCmd=["python","manage.py","check_runtime","--role","indexer"]
HealthInterval=5s
HealthTimeout=5s
HealthRetries=20
HealthStartPeriod=10s
Notify=healthy

[Service]
# Like compose's unless-stopped: retry without limit, backing off from 5s to Docker's 1min cap
# (RestartSteps= and RestartMaxDelaySec= need systemd 254 or newer).
Restart=on-failure
RestartSec=5
RestartSteps=8
RestartMaxDelaySec=60
# The start waits for health: allow the whole compose window, 10s + 20 x (5s + 5s).
TimeoutStartSec=300

[Install]
WantedBy=default.target
